// ---------------------------------------------------------------------------
// Admin's two 3D authoring surfaces — one row per project each, replacing
// the store's project3DConfigs / projectMapModels Records.
//
// ProjectMapModel/ProjectDetailModel/UnitMeshLink below are LEGACY as of
// the versioning pass (PRD_Admin_Mapbox_GLB / PRD_Admin_3D_Project_Experience)
// — superseded by MapModelVersion/DetailModelVersion/UnitMeshLinkV2 further
// down, which add version history, draft/publish/rollback and validation
// status instead of one mutable row per project. Kept in place, unused by
// any route once the admin editors switch over, as a one-release safety
// net (their data was copied forward by scripts/migrate-3d-versions.ts) —
// drop them in a follow-up migration once the new tables are confirmed
// stable in production. Project3DConfig is now real as of the "3D
// Experience Phase 1" pass (GET/PATCH /api/project-3d-config/[projectId],
// see src/lib/adminAuth.ts's requireAdmin() for the write gate) — the
// rendering-mode/quality-preset/glass/sky/sun fields below drive the
// standalone WebGPU/WebGL2 viewer (ProceduralProjectViewer.tsx), which
// replaced the old Mapbox-embedded detail-model path in the same pass.
// ---------------------------------------------------------------------------

model Project3DConfig {
  projectId                     String  @id
  groundEnabled                 Boolean @default(true)
  /// "disc" | "infinite" — Ground Platform follow-up (same day as Sky/
  /// Water/Bloom/Clouds). "infinite" is the only style available in GLB
  /// mode; "disc" stays procedural-mode-only, unchanged — deliberately
  /// scoped so no existing GLB project gains an unrequested ground.
  groundStyle                   String  @default("disc")
  /// Applies regardless of groundStyle — default matches the exact hex
  /// the ground was hardcoded to before this column existed.
  groundColor                   String  @default("#d8d6e6")
  /// Real "ground fog" — a circular radial color fade on the ground
  /// mesh's own material around world origin (0,0,0), distinct from
  /// fogEnabled/fogColor's camera-relative THREE.FogExp2 above. Off by
  /// default.
  groundFogEnabled              Boolean @default(false)
  /// World-space distance from (0,0,0) — admin-entered directly.
  groundFogRadius               Float   @default(300)
  cameraStartDistanceMultiplier Float   @default(1)
  cameraMinDistanceMultiplier   Float   @default(0.4)
  cameraMaxDistanceMultiplier   Float   @default(2.5)
  cameraMaxPolarDeg             Int     @default(85)
  cameraMinPolarDeg             Int     @default(0)
  /// Kept but no longer consulted by the public viewer — Idle Drone
  /// Camera PRD replaced its cinematic-idle role. See idleDroneEnabled
  /// below; a one-time migration copied each existing row's value here.
  autoRotate                    Boolean @default(true)
  /// Idle Drone Camera PRD — procedural architectural orbit replacing
  /// plain OrbitControls.autoRotate. See src/lib/render-engine/
  /// idleDroneCamera.ts and Project3DConfig's own TS doc comment
  /// (src/lib/types.ts) for the full field-by-field explanation.
  idleDroneEnabled               Boolean @default(true)
  idleDroneDelaySec              Int     @default(60)
  idleDroneOrbitDurationSec      Float   @default(80)
  idleDroneClockwise             Boolean @default(true)
  idleDroneMotionEnabled         Boolean @default(true)
  idleDroneHeightEnabled         Boolean @default(true)
  idleDroneHeightAmplitude       Float   @default(0.18)
  idleDroneDistanceEnabled       Boolean @default(true)
  idleDroneDistanceAmplitude     Float   @default(0.05)
  idleDroneTargetEnabled         Boolean @default(true)
  idleDroneTargetAmplitude       Float   @default(0.06)
  idleDroneVerticalCycles        Int     @default(2)
  idleDronePhaseOffsetDeg        Float   @default(0)
  idleDroneSmoothness            Float   @default(0.88)
  // "Construction Stage reveal" (the translucent per-building shell
  // outlines + progressive per-floor unit-box hiding based on
  // constructionProgressPercent, both procedural-mode-only — see
  // RenderEngine.ts's git history) removed entirely 2026-08-14 at the
  // user's explicit request, along with its `constructionStagesEnabled`
  // column — not kept as a dead toggle. The separate, still-live
  // `constructionProgressPercent` shown in the public viewer's header
  // pill/timeline strip (useProjectConstruction/ConstructionTimelineStrip)
  // is untouched — it never depended on this column.
  status                        String  @default("draft")

  // "3D Experience Phase 1" — rendering foundation, quality presets, glass.
  // See src/lib/viewerPresets.ts.
  renderingMode                      String  @default("auto") // auto | webgpu | webgl2
  qualityPreset                      String  @default("high_desktop")
  // ultra_desktop | high_desktop | balanced | mobile_high | mobile_low | custom
  /// Experience Editor v2, Performance tab (PRD §40) additions.
  /// `custom*` only apply when qualityPreset === "custom" — every other
  /// preset uses its own fixed QUALITY_TIERS entry (viewerPresets.ts),
  /// unchanged. Null = "use the preset's own value."
  customRenderScale                  Float?
  customDprCap                       Float?
  adaptiveQualityEnabled             Boolean @default(true)
  /// Whether Adaptive Quality's real downgrade step (render-scale
  /// reduction under sustained low frame time) is allowed to trigger at
  /// all during normal playback, vs. only while the camera is actively
  /// being dragged (interactionQualityReductionEnabled) — PRD's Runtime/
  /// Interaction Quality Reduction split.
  runtimeQualityReductionEnabled     Boolean @default(true)
  interactionQualityReductionEnabled Boolean @default(true)
  deviceDetectionEnabled             Boolean @default(true)
  // ultra_desktop | high_desktop | balanced | mobile_high | mobile_low
  glassPreset                        String  @default("standard") // performance | standard | premium
  environmentIntensity               Float   @default(1)
  cameraFovDesktop                   Int     @default(38)
  cameraFovMobile                    Int     @default(48)

  /// Experience Editor v2, Camera tab (PRD §37) additions — everything
  /// above this point (cameraStart/Min/MaxDistanceMultiplier, cameraMin/
  /// MaxPolarDeg, autoRotate, cameraFovDesktop/Mobile) already existed
  /// and is reused as-is, not duplicated. These are the genuinely missing
  /// fields. Defaults match RenderEngine.ts's own pre-existing hardcoded
  /// values exactly, so no existing project's camera behavior changes
  /// until an admin touches this tab.
  cameraNearClip         Float   @default(0.1)
  cameraFarClip          Float   @default(2000)
  /// Null = unrestricted (OrbitControls' own default) — same "nullable
  /// means off" pattern the rest of this schema already uses.
  cameraMinAzimuthDeg    Float?
  cameraMaxAzimuthDeg    Float?
  cameraOrbitEnabled     Boolean @default(true)
  cameraPanEnabled       Boolean @default(true)
  cameraZoomEnabled      Boolean @default(true)
  cameraDampingEnabled   Boolean @default(true)
  /// Real per-project toggle for the already-existing DOF auto-focus-
  /// from-orbit-distance behavior (see depthOfFieldEnabled's own doc
  /// comment) — stored now, takes effect once Depth of Field is wired
  /// into the new engine (Rendering tab, later phase).
  cameraAutoFocusEnabled Boolean @default(true)
  /// Debug-only camera frustum wireframe (viewport helper, PRD §4's
  /// "Camera Helper" toggle) — admin-editor-only, never shown publicly.
  cameraHelperEnabled    Boolean @default(false)
  /// 35mm-equivalent sensor width (mm) — the one extra fact needed to
  /// convert this camera's real FOV into a "Focal Length (mm)" figure
  /// admins coming from real cinematography/photography expect (PRD's
  /// separate Focal Length + "Sensor / Film Gate" controls); 36mm is the
  /// standard full-frame reference, so the default Focal Length shown
  /// matches a real 36mm-sensor camera at the existing default FOV.
  cameraSensorWidthMm    Float   @default(36)

  /// Sky/Water/Bloom/Clouds "Ocean" tab (webgl_shaders_ocean.html parity)
  /// — direct sun elevation/azimuth feeding the physical SkyMesh, matching
  /// the reference demo's own GUI exactly (no geographic date/time
  /// simulation, no manual/geographic mode split — this is the only sun
  /// model now). Removed 2026-08-14 at the user's explicit request,
  /// along with the whole geographic-sun/HDRI/lensflare/light-probe/
  /// motion-blur system this project had grown around it: sunMode,
  /// sunIntensity, northRotationDeg, defaultTimeOfDay, allowUserTimeChange,
  /// simulationDate, hdriId (+ the PlatformHdri table), lensflareEnabled,
  /// lightProbeEnabled, motionBlurEnabled/Amount, skyPreset,
  /// backgroundPreset, backgroundBlurriness, bloomThreshold, and the
  /// separate volumetricCloud* fields (a different reference demo,
  /// webgl_volume_cloud.html — out of scope for this tab). Not kept as
  /// dead toggles — dropped as real columns via a live migration.
  /// `lightingPreset` (already dead/unread) dropped in the same pass.
  /// `lutEnabled`/`lutPreset`/`lutIntensity` (3D LUT color grading) is
  /// explicitly KEPT, further down this model — see its own doc comment.
  sunAzimuthDeg   Float @default(180)
  sunElevationDeg Float @default(45)

  /// Experience Editor v2, Environment → Sun & Sky (PRD §9-10, "ROZARIS
  /// Manual Time + Sun System" / "ONE Global Sun"). `solarControllerEnabled`
  /// gates the whole system: off (default) keeps every existing project's
  /// sun exactly as before — a static direct sunElevationDeg/sunAzimuthDeg,
  /// zero behavior change. On, elevation/azimuth are DERIVED every frame
  /// from Viewer Time + a Solar Path (manual anchors or real geographic
  /// lat/lon/date) instead of being authored directly — see
  /// RenderEngine.ts's resolveGlobalSunVector and src/lib/sunPosition.ts.
  /// The result feeds the exact same single `sunDirection` Vector3 every
  /// other Environment/Lighting feature reads (Sky/Water/Clouds/Fog today;
  /// Shadows/GI/Volumetrics/Lens Flare in later phases) — no feature is
  /// ever allowed its own separate sun.
  solarControllerEnabled    Boolean  @default(false)
  /// "manual" = interpolate `solarAnchors`; "geographic" = real solar
  /// position from geoLatitude/geoLongitude/simulationDate.
  solarPathMode             String   @default("manual")
  /// Whether a live Viewer Time slider is exposed (public viewer's own
  /// Interaction-tab wiring is a later phase — this is the admin-editor/
  /// data-layer half of the switch). Off: `viewerTimeHours` is a fixed
  /// "Default Time", not a live-adjustable one.
  viewerTimeControlEnabled  Boolean  @default(false)
  viewerTimeHours           Float    @default(12)
  viewerTimeStartHours      Float    @default(6)
  viewerTimeEndHours        Float    @default(20)
  viewerTimeStepMinutes     Int      @default(15)
  /// Manual Solar Path anchors — SolarAnchor[] (src/lib/sunPosition.ts):
  /// `[{id, timeHours, elevationDeg, azimuthDeg}]`. Null/absent reads as
  /// `[]` client-side, same nullable-Json? pattern as cameraPresets/
  /// sections above.
  solarAnchors              Json?
  /// Geographic Solar Path — real lat/lon (defaults to Tirana, Albania,
  /// this platform's home market) + a simulated calendar date (year/month/
  /// day only; time-of-day comes from viewerTimeHours). See
  /// src/lib/sunPosition.ts's geographicSunPosition.
  geoLatitude               Float    @default(41.3275)
  geoLongitude              Float    @default(19.8187)
  simulationDate            DateTime @default(now())
  /// Rotates the whole solar path's azimuth output — lets an admin align
  /// "north" in the authored path with the GLB's own arbitrary export
  /// orientation without re-authoring every anchor.
  northOffsetDeg            Float    @default(0)
  /// SkyMesh.showSunDisc passthrough (real existing uniform — see
  /// SkyMesh.js) — useful to turn off when composing a PMREM environment
  /// capture to avoid a fireball artifact (SkyMesh's own doc comment).
  sunDiscEnabled            Boolean  @default(true)
  /// Off = use manualSunIntensity/manualSunColorHex directly instead of
  /// the existing elevation-driven sunColorForElevation()/intensity-curve
  /// formula (RenderEngine.ts's applyGlobalSun).
  autoSunIntensityEnabled   Boolean  @default(true)
  autoSunColorEnabled       Boolean  @default(true)
  manualSunIntensity        Float    @default(1.2)
  manualSunColorHex         String   @default("#ffffff")
  /// Off = the real debounced PMREM sky-environment recapture
  /// (scheduleEnvironmentRebuild) never re-runs after the initial mount,
  /// even as Viewer Time/sun moves — freezes indirect lighting/reflections
  /// at their mount-time state as a real perf lever for scenes that don't
  /// need it to track a moving sun.
  environmentRefreshEnabled Boolean  @default(true)

  /// New standalone "Sky" tab (webgl_shaders_sky.html parity, 2026-08-14
  /// — separate from and added after the "Ocean" tab above). That
  /// reference demo's own GUI is elevation/azimuth/exposure (already
  /// covered by sunElevationDeg/sunAzimuthDeg/exposure — reused, not
  /// duplicated as columns) plus turbidity/rayleigh/mieCoefficient/
  /// mieDirectionalG, previously a single fixed constant
  /// (viewerPresets.ts's SKY_PHYSICAL_PARAMS) applied to every project —
  /// now real per-project columns, defaulted to that exact prior fixed
  /// tuple so no existing project's rendered sky changes until an admin
  /// touches this tab. `skyEnabled` is a Rozaris-specific addition (the
  /// reference demo has no off switch — its Sky is always the scene) per
  /// explicit user request ("possibility to turn off"); false falls back
  /// to a flat neutral background/environment instead of the physical
  /// dome — see RenderEngine.ts's rebuildEnvironment. Default true: zero
  /// behavior change for any existing project (the physical sky dome was
  /// already the unconditional backdrop before this column existed).
  skyEnabled         Boolean @default(true)
  skyTurbidity       Float   @default(4)
  skyRayleigh        Float   @default(2.4)
  skyMieCoefficient  Float   @default(0.004)
  skyMieDirectionalG Float   @default(0.78)

  /// Experience Editor "Map" tab — places this project's own detailed 3D
  /// model (its `DetailModelSlot` with `role: "building"`, the same GLB
  /// Studio renders) onto a real Mapbox map at its real-world location, as
  /// an alternate, toggle-able view alongside the freestanding Studio scene
  /// (mutually exclusive, never both mounted at once — see
  /// ProjectViewerRuntime.tsx's `viewMode`). Deliberately separate from, and
  /// not to be confused with, `MapModelVersion` below: that's a different
  /// feature (the platform-wide public Search Map's lightweight per-project
  /// proxy GLB, shown alongside every other project at once). This one is
  /// single-project, driven by this same config row, and reads the sun
  /// fields above (`sunAzimuthDeg`/`sunElevationDeg`/`manualSunIntensity`/
  /// `manualSunColorHex`/etc., via src/lib/sunPosition.ts) to light the
  /// Mapbox render to match — see ProjectMapView.tsx.
  mapViewEnabled    Boolean @default(false)
  /// Null on either falls back to the project's own `coords` (Project
  /// model) — an admin only needs to set these once they actually drag the
  /// model to a different spot than the project's default pin.
  mapViewLatitude   Float?
  mapViewLongitude  Float?
  mapViewAltitude   Float   @default(0)
  mapViewHeadingDeg Float   @default(0)
  mapViewScale      Float   @default(1)
  /// The Mapbox camera itself (distinct from the three fields above, which
  /// place the *model* on the map) — how far zoomed in, tilted, and rotated
  /// the map is when this project's Map tab/view opens. Defaults match the
  /// literals ProjectMapView.tsx used before these fields existed, so an
  /// unmigrated/never-edited row renders identically to before.
  mapViewZoom       Float   @default(17.5)
  mapViewPitchDeg   Float   @default(60)
  mapViewBearingDeg Float   @default(-20)

  /// "Map" tab, 2026-08-26 rewrite — real-world SITE CONTEXT rebuilt as
  /// ordinary three.js geometry from Mapbox raster-DEM + satellite tiles,
  /// living inside the engine's own scene graph (so it is lit by the ONE
  /// Global Sun Vector and picks up fog/SSGI/SSR/DOF/TRAA/LUT for free).
  /// This REPLACES the meaning of the nine mapView* columns above, which
  /// drove a separate mapbox-gl view the visitor switched to; those
  /// columns are retained, not dropped, because projectLocation.ts's
  /// syncProjectLocationDependents() writes mapViewLatitude/Longitude on
  /// every project move.
  ///
  /// Transform rule: the SITE moves, the building never does. siteOffsetX
  /// /Z, siteElevationOffset, siteRotationDeg and siteScale move the world
  /// around the project's authored origin — the opposite direction from
  /// the mapView* placement fields above.
  ///
  /// siteRotationDeg additionally feeds the sun: rotating the site is the
  /// admin stating where north is, so it is added to the resolved sun
  /// azimuth exactly as northOffsetDeg is. See src/lib/types.ts for the
  /// derivation. All defaults are the feature-absent state.
  siteEnabled           Boolean @default(false)
  siteRadiusM           Float   @default(600)
  siteTerrainEnabled    Boolean @default(true)
  siteImageryEnabled    Boolean @default(true)
  siteImageryBrightness Float   @default(0.85)
  siteOffsetX           Float   @default(0)
  siteOffsetZ           Float   @default(0)
  siteElevationOffset   Float   @default(0)
  siteRotationDeg       Float   @default(0)
  siteScale             Float   @default(1)

  /// 360° Backdrop Photo — an admin-uploaded equirectangular PNG (real
  /// site-context photography) with a transparent sky region, composited
  /// as an unlit sphere just inside the SkyMesh dome so the physical sky/
  /// sun above keep showing through the transparent pixels — see
  /// RenderEngine.ts's backdropMesh. `backdropImageUrl` is a Vercel Blob
  /// URL (`panoramas/` prefix, /api/blob/upload); `backdropRotationDeg`
  /// (move left/right) aligns the photo's real captured heading with the
  /// scene's own `northOffsetDeg`; `backdropPitchDeg` (move up/down, ±90°)
  /// tilts it to line the photo's own horizon up with the platform's;
  /// `backdropElevation` (±500 scene units) instead TRANSLATES the
  /// sphere's own center — for a photo whose horizon is already level but
  /// was shot from a different height than the model's own ground.
  /// Default off/null/0: zero behavior change for any existing project.
  backdropEnabled     Boolean @default(false)
  backdropImageUrl    String?
  backdropRotationDeg Float   @default(0)
  backdropPitchDeg    Float   @default(0)
  backdropElevation   Float   @default(0)

  // Full-configurator pass — Fog, per-project unit status colors, and
  // per-project post-processing overrides (ANDed with, not replacing,
  // QUALITY_TIERS' own tier-level flags — see viewerPresets.ts).
  fogEnabled    Boolean @default(false)
  fogColor      String  @default("#c9d6e0")
  fogDensity    Float   @default(0.015)
  /// When true, fog color is derived live from the resolved sky color
  /// instead of the authored `fogColor` above — the "seamless horizon"
  /// technique from three.js's webgl_geometry_terrain example. Default
  /// false: zero behavior change for any existing project.
  fogMatchesSky Boolean @default(false)

  /// Experience Editor v2, Environment → Fog & Haze (PRD §12,
  /// webgpu_custom_fog.html parity) — real TSL `scene.fogNode` height fog +
  /// distance haze + animated `triNoise3D` wisps (src/lib/render-engine/
  /// fog.ts), layered ON TOP of the classic fogEnabled/fogColor/fogDensity/
  /// fogMatchesSky THREE.FogExp2 above when both are on (fogEnabled stays
  /// the master switch for "is there any fog at all"; these are its extra
  /// height/haze/noise dimensions, not a replacement). Distinct from
  /// `groundFogEnabled` further up this model (Ground tab's own radial
  /// mist-near-origin effect on the ground MATERIAL, a different, older
  /// technique) — `fogHeightBandEnabled` is PRD §12's "Ground Fog", a real
  /// atmospheric height band affecting the whole scene via the fog node.
  /// All new toggles off/neutral by default: zero behavior change for any
  /// existing project until an admin opens this tab.
  fogHeightBandEnabled     Boolean @default(false)
  fogHazeEnabled           Boolean @default(false)
  fogNoiseEnabled          Boolean @default(false)
  fogMovementEnabled       Boolean @default(true)
  fogSunInteractionEnabled Boolean @default(true)
  fogBaseHeight            Float   @default(0)
  fogTopHeight             Float   @default(40)
  fogHaze                  Float   @default(0.3)
  fogNoiseStrength         Float   @default(0.3)
  fogNoiseScale            Float   @default(0.05)
  fogWindDirectionDeg      Float   @default(0)
  fogWindSpeed             Float   @default(0.02)
  fogFalloff               Float   @default(1)
  fogMaxOpacity            Float   @default(0.85)
  // `sectionCapStencilEnabled` column removed 2026-08-14 — the real
  // stencil-buffer-derived Section cap silhouette (webgl_clipping_stencil.html
  // technique) it gated is no longer a project-wide opt-in: it's now
  // unconditional for any `fillGapsEnabled` section (RenderEngine.ts's
  // rebuildSectionCap), since the opt-in default (off) is exactly what
  // was reported as "colors the clipper plane instead [of the clipped
  // model]" — the toggle was buried in the Effects tab, off by default,
  // invisible from the Sections tab where fillColor is actually picked,
  // so almost nobody ever found their way to the already-correct
  // behavior. `stencil: true` moved to the WebGPURenderer's fixed
  // constructor options instead of this column.

  // Sky/Water/Bloom/Clouds pass (webgl_shaders_ocean.html parity) —
  // real HDR bloom (dormant TSL node, now a per-project toggle), a real
  // WaterMesh water plane, and procedural clouds on the physical sky
  // dome (SkyMesh — see RenderEngine.ts's rebuildEnvironment, which
  // replaced the old CanvasTexture gradient sky with it this same pass).
  // All default false/off: zero behavior change for any existing project
  // beyond the sky itself becoming physically-based (an accepted visual
  // change, not gated behind a flag — see the plan's Sky Rollout
  // decision).
  bloomEnabled  Boolean @default(false)
  bloomStrength Float   @default(0.1)
  bloomRadius   Float   @default(0)

  waterEnabled         Boolean @default(false)
  waterDistortionScale Float   @default(3.7)
  waterSize            Float   @default(1)

  /// Experience Editor v2, Environment → Water (PRD §13) — extends the
  /// pre-existing WaterMesh wiring above with the rest of the reference
  /// demo's own knobs + PRD-named toggles. Honest split (RenderEngine.ts's
  /// createWaterMesh/applyGlobalSun doc comments carry the full reasoning):
  /// `waterType` is a real cosmetic preset picker (sets sensible
  /// color/size defaults when chosen, not a distinct render path).
  /// `waterHeight`/`waterColor` are real (mesh Y position / colorNode
  /// uniform). `waterSunReflectionEnabled` is real (zeroes the specular
  /// term). `waterWavesEnabled`/`waterNormalMapEnabled` are real, ANDed
  /// together against `waterDistortionScale` (this shader has one shared
  /// normal-map-driven distortion mechanism, not two independent ones).
  /// `waterMovementEnabled`/`waterEnvReflectionEnabled`/`waterDeepColor`
  /// are stored (so switching them off/on later restores state, per the
  /// PRD's own ON/OFF contract) but not yet wired to a render difference —
  /// WaterMesh's shared `time` TSL node has no per-instance pause, and the
  /// planar `reflector()` mirror is baked into the material's colorNode at
  /// construction, not a runtime-togglable term. Same honest "stored, not
  /// yet wired" precedent InteractionPanel.tsx already established.
  waterType                 String  @default("decorative")
  waterWavesEnabled         Boolean @default(true)
  waterMovementEnabled      Boolean @default(true)
  waterSunReflectionEnabled Boolean @default(true)
  waterEnvReflectionEnabled Boolean @default(true)
  waterNormalMapEnabled     Boolean @default(true)
  waterHeight               Float   @default(0)
  waterColor                String  @default("#001e0f")
  waterDeepColor            String  @default("#00131f")

  /// Sky/Water/Bloom/Clouds "Ocean" tab — webgl_shaders_ocean.html's own
  /// "Clouds" GUI folder is really 3 more uniforms on its Sky object, not
  /// a separate mesh; these feed SkyMesh.cloudCoverage/cloudDensity/
  /// cloudElevation directly (see RenderEngine.ts's applySunAndEnvironment).
  /// A different, second cloud implementation (real 3D-texture
  /// raymarching, webgl_volume_cloud.html parity) used to live alongside
  /// this one on its own tab — removed entirely 2026-08-14 (out of scope
  /// for this demo's own Clouds panel), along with its
  /// volumetricCloudEnabled/Threshold/Opacity/Range/Steps columns.
  cloudsEnabled  Boolean @default(false)
  cloudCoverage  Float   @default(0.4)
  cloudDensity   Float   @default(0.5)
  cloudElevation Float   @default(0.5)

  /// Experience Editor v2, Environment → Clouds (PRD §11,
  /// webgpu_volume_cloud.html parity) — the ONE user-facing "Clouds"
  /// feature per PRD §11's own "do not implement another public cloud
  /// system" rule. `cloudCoverage`/`cloudDensity`/`cloudElevation` above
  /// are now shared inputs to BOTH systems: (1) the real raymarched cloud
  /// layer below (src/lib/render-engine/clouds.ts — several TSL Loop()
  /// steps sampling `triNoise3D`-based density between cloudHeight and
  /// cloudHeight+cloudThickness, lit by the Global Sun Vector), used on
  /// medium/high quality tiers, and (2) SkyMesh's own built-in cloud
  /// uniforms (cheap, baked into the sky-dome shader), used as the real
  /// Low/Mobile-tier internal fallback the PRD explicitly allows — never
  /// both at once (RenderEngine.ts's applyGlobalSun zeroes whichever isn't
  /// active for the current tier). All new fields off/neutral-default:
  /// zero behavior change for any existing project.
  cloudMovementEnabled    Boolean @default(true)
  cloudSunLightingEnabled Boolean @default(true)
  /// Real, simplified (not a per-pixel projected shadow map) — a soft
  /// coverage-driven darkening sampled at the same noise UV, mixed into
  /// the ground material's colorNode (buildGroundMaterial) when a ground
  /// mesh exists.
  cloudShadowsEnabled     Boolean @default(false)
  cloudHeight             Float   @default(220)
  cloudThickness          Float   @default(50)
  cloudThreshold          Float   @default(0.45)
  cloudOpacity            Float   @default(0.85)
  cloudSoftness           Float   @default(0.35)
  cloudScale              Float   @default(0.01)
  cloudWindSpeed          Float   @default(0.02)
  cloudWindDirectionDeg   Float   @default(45)
  cloudRaymarchSteps      Int     @default(16)

  /// webgl_watch.html parity — real, previously-unset THREE.js property
  /// (DirectionalLight.shadow.radius) that always defaulted to its engine
  /// default (0 — hard shadow edge) with no admin control. Default here
  /// matches that engine default exactly.
  shadowSoftness Float @default(0)

  // 3D LUT color grading (webgl_postprocessing_3dlut.html parity) — every
  // option the reference demo's own GUI exposes: `enabled`, a 9-way `lut`
  // dropdown (all 9 of the demo's own vendored presets — 5 real `.CUBE`
  // files via `LUTCubeLoader`, 1 real `.3dl` file via `LUT3dlLoader`, 3
  // real image-strip LUTs via `LUTImageLoader` — see viewerPresets.ts's
  // `LUT_PRESETS` and RenderEngine.ts's `loadLut` for the loader-per-
  // format dispatch, and `public/luts/` for the vendored assets), and
  // `intensity`. `lutPreset` is a free string, not a Prisma enum,
  // validated against the real available-preset list at the zod layer
  // instead. Off by default: zero behavior change for any existing
  // project.
  lutEnabled   Boolean @default(false)
  lutPreset    String  @default("bourbon64")
  lutIntensity Float   @default(1)

  // Depth of field (webgl_postprocessing_dof2.html parity) — TSL `dof()`
  // node, real bokeh blur sampled from the scene's own viewZ (depth)
  // buffer. `focusDistance` isn't a stored field — RenderEngine.ts
  // recomputes it every frame from the real live camera-to-orbit-target
  // distance (`camera.position.distanceTo(controls.target)`), same "auto-
  // focus on whatever's framed" behavior a real camera's autofocus gives,
  // rather than a manual distance an admin would have to keep in sync with
  // wherever a visitor happens to orbit the camera. `focalLength`/
  // `bokehScale` mirror the TSL node's own param names/defaults (1/1).
  // Off by default: zero behavior change for any existing project.
  depthOfFieldEnabled     Boolean @default(false)
  depthOfFieldFocalLength Float   @default(10)
  depthOfFieldBokehScale  Float   @default(1)

  /// Real logarithmic depth buffer (`webgpu_camera_logarithmicdepthbuffer.html`
  /// parity) — `logarithmicDepthBuffer: true` passed to the WebGPURenderer
  /// constructor, reducing z-fighting at this app's scale (camera far
  /// plane is a fixed 2000 units — see RenderEngine.ts's mount()). A
  /// renderer-construction-time flag like `stencil`/`forceWebGL`, so it
  /// needs a fresh mount to take effect. Default false: zero behavior
  /// change for any existing project.
  logarithmicDepthEnabled Boolean @default(false)

  /// Loading-screen reveal (webgl_postprocessing_transition.html
  /// technique) — real per-project on/off (per explicit user request:
  /// "every feature has an option to turn it on/off"). Default true is a
  /// deliberate exception to this file's usual "off by default" rule —
  /// same "accepted visual default change, not gated behind a flag"
  /// precedent the physical sky dome rollout already used — since this is
  /// a purely cosmetic one-time mount transition with no functional
  /// behavior to preserve for existing projects.
  loadingRevealEnabled Boolean @default(true)

  /// Hex colors for the 4 unit statuses + the shared "selected" highlight —
  /// defaults match the previously-hardcoded UNIT_BOX_COLOR/SELECTED_COLOR
  /// constants in viewerPresets.ts exactly, so existing projects render
  /// identically until an admin changes them.
  unitColorAvailable String @default("#22c55e")
  unitColorReserved  String @default("#eab308")
  unitColorSold      String @default("#ef4444")
  unitColorSelected  String @default("#6b55f5")

  // Unit-status caustics (webgpu_caustics.html parity, adapted — see
  // RenderEngine.ts's buildCausticsNode doc comment for the real technique
  // and the honest deviations from the reference's refract()/
  // castShadowNode approach) — procedural-mode unit boxes only. Explicitly
  // linked to all 3 things the user asked for: color reuses the real
  // unitColor* fields above (no separate caustics-color fields), intensity
  // is per-availability-status (causticsIntensity*), and scale/speed are
  // the real tunable caustics properties. Off by default: zero behavior
  // change for any existing project.
  causticsEnabled            Boolean @default(false)
  causticsScale              Float   @default(0.5)
  causticsSpeed              Float   @default(0.15)
  causticsIntensityAvailable Float   @default(1)
  causticsIntensityReserved  Float   @default(0.4)
  causticsIntensitySold      Float   @default(0)

  /// shadowsEnabled/antialiasEnabled are real and functional. ssrEnabled/
  /// gtaoEnabled (screen-space reflections/ambient occlusion) used to be
  /// columns here — dropped entirely 2026-08-13 at the user's explicit
  /// request, after that TSL chain caused two unexplained real-GPU
  /// rendering failures and was implicated in a later real Sections-panel
  /// instability report. See viewerPresets.ts's QUALITY_TIERS header
  /// comment for the full history.
  shadowsEnabled   Boolean @default(true)
  antialiasEnabled Boolean @default(true)

  // Render/visual quality pass — real TSL post-processing, camera
  // presets. See src/lib/viewerPresets.ts (quality-tier post-fx flags)
  // and ProceduralProjectViewer.tsx (RenderPipeline wiring).
  /// Admin-saved camera framings — [{ id, label, position: {x,y,z},
  /// target: {x,y,z}, fov, durationMs, easing }]. Clicking one in the
  /// public viewer smoothly transitions the live camera to it.
  cameraPresets Json?
  /// Tone-mapping exposure multiplier (renderer.toneMappingExposure) —
  /// also the Sky/Water/Bloom/Clouds "Ocean" tab's Sky "exposure" slider,
  /// matching webgl_shaders_ocean.html's own GUI exactly.
  exposure      Float  @default(1)
  /// renderer.toneMapping (2026-08-14 UI-polish pass) — real per-project
  /// choice: none | linear | reinhard | cineon | aces | agx | neutral.
  /// Defaults to "aces" (renderer.toneMapping's prior hardcoded value) so
  /// every project predating this column keeps rendering identically.
  toneMapping   String @default("aces")

  // Publish/runtime hardening pass.
  /// Which of the always-on bottom-menu controls (Home/Unit Search/Time
  /// of Day/View Preset) show publicly — { home, unitSearch, timeOfDay,
  /// viewPreset }, all booleans. Xray/Camera Presets aren't included:
  /// they're already conditional on real state (a loaded GLB / at least
  /// one saved preset). Null/absent reads as "all enabled" client-side —
  /// no backfill migration needed for existing rows.
  viewerUI Json?

  // Sections module (first-class Configurator module) — admin-authored
  // rectangular clipping-plane cuts. [{ id, name, scope, buildingName?,
  // centerX, centerZ, widthM, depthM, rotationDeg, heightM, bottomEnabled,
  // stylePreset, cameraPreset?, floorId?, hidden? }], see the `Section`
  // TS interface (src/lib/types.ts) for the full shape. Never touches the
  // GLB itself — render-time clipping planes/cap only. Null/absent reads
  // as `[]` client-side, same nullable-Json?-column pattern as
  // cameraPresets/viewerUI above — no backfill needed for existing rows.
  sections Json?

  /// Experience Editor v2, Lighting tab (PRD §14-21) — Sun Light, Shadows
  /// (CSM/Contact/Transmitted), Global Illumination (SSGI), Artificial
  /// Lights, Volumetric Lighting. All real, canonical-Git-sourced vendored
  /// three.js modules (CSMShadowNode, SSGINode, GTAONode, GodraysNode,
  /// IESSpotLight/IESLoader — all real classes already ships in this exact
  /// three.js version, not re-derived). Off/neutral by default throughout:
  /// zero behavior change for any existing project until an admin opens
  /// this tab. See RenderEngine.ts's applyLightingConfig/buildPostPipeline
  /// for the real shared MRT scene-pass + post-processing chain this tab
  /// introduces (PRD §43's "shared render graph", first built here since
  /// SSGI/Contact-AO/Godrays are its first real consumers; Rendering tab's
  /// SSR/TRAA/Bloom/DOF/MotionBlur/LUT — Phase 4 — extend the same chain).
  ///
  /// Sun Light — reuses Environment → Sun & Sky's autoSunIntensityEnabled/
  /// autoSunColorEnabled/manualSunIntensity/manualSunColorHex (the same
  /// ONE sun light, not a duplicate system) — these two are new.
  sunLightEnabled Boolean @default(true)
  /// Kelvin — moving this slider recomputes manualSunColorHex via a real
  /// Planckian-locus approximation (src/lib/colorTemperature.ts), a
  /// convenience alternate input method for the same field, not a second
  /// stored color.
  sunTemperatureK Int     @default(5500)

  /// Cascaded Shadow Maps (webgpu_shadowmap_csm.html parity, CSMShadowNode)
  /// — real cascaded shadows on `sun`, replacing the single fixed shadow
  /// frustum. Off keeps today's single-cascade shadow behavior unchanged.
  csmEnabled         Boolean @default(false)
  csmCascades        Int     @default(3)
  csmMaxDistance     Float   @default(200)
  csmResolution      Int     @default(2048)
  csmSplitMode       String  @default("practical")
  csmMargin          Float   @default(100)
  softShadowsEnabled Boolean @default(true)

  /// Contact Shadows (webgpu_shadow_contact.html parity, real small-radius
  /// GTAONode — a genuinely different, tighter-radius use of the same
  /// canonical AO node than SSGI's own AO term, not a competing SSAO
  /// feature per PRD §19's "do not create a separate SSAO" rule, which is
  /// about Global Illumination specifically).
  contactShadowsEnabled Boolean @default(false)
  contactShadowBlur     Float   @default(0.5)
  contactShadowDarkness Float   @default(0.6)
  contactShadowOpacity  Float   @default(0.8)
  contactShadowRange    Float   @default(0.3)

  /// Transmitted / Colored Shadows (webgpu_shadowmap_opacity.html parity)
  /// — real per-mesh `castShadowNode` override for GLB nodes matching the
  /// existing `Glass_*` naming convention (GLASS_NODE_PATTERN,
  /// viewerPresets.ts), tinting their cast shadow by the glass's own
  /// attenuation color instead of a flat opaque shadow.
  transmittedShadowsEnabled Boolean @default(false)
  coloredShadowsEnabled     Boolean @default(false)
  transmittedShadowStrength Float   @default(0.6)

  /// Global Illumination (webgpu_postprocessing_ssgi.html parity, SSGINode
  /// — real screen-space GI + AO, the ONE GI system per PRD §19; no
  /// separate LightProbeGrid feature). Field names mirror the node's own
  /// uniform names exactly.
  giEnabled             Boolean @default(false)
  giIndirectEnabled     Boolean @default(true)
  giAOEnabled           Boolean @default(true)
  giBackfaceLighting    Boolean @default(false)
  giTemporalFiltering   Boolean @default(true)
  giScreenSpaceSampling Boolean @default(true)
  giIntensity           Float   @default(10)
  giAOIntensity         Float   @default(1)
  giRadius              Float   @default(12)
  giSliceCount          Int     @default(1)
  giStepCount           Int     @default(12)
  giExpFactor           Float   @default(2)
  giThickness           Float   @default(1)
  giLinearThickness     Boolean @default(false)

  /// Artificial Lights (webgpu_lights_ies_spotlight.html parity for the
  /// IES type) — admin-authored point/spot/IES-spot/rect-area lights.
  /// ArtificialLight[] (src/lib/types.ts) — same typed-JSON-array pattern
  /// as cameraPresets/sections. Null/absent reads as `[]` client-side.
  artificialLights Json?

  /// Volumetric Lighting (webgpu_volume_lighting.html parity for the
  /// technique; Sun Shafts specifically use the real vendored GodraysNode
  /// — screen-space godrays from the Global Sun Vector, depth-occluded).
  /// "Artificial Light Volumes" is a real, simplified per-light billboard
  /// cone (ArtificialLight.volumetricEnabled), not a second raymarch
  /// system — see RenderEngine.ts's own doc comment for the honest scope
  /// call.
  volumetricLightingEnabled Boolean @default(false)
  sunShaftsEnabled          Boolean @default(true)
  lightVolumesEnabled       Boolean @default(false)
  volumetricRaymarchSteps   Int     @default(60)
  volumetricDensity         Float   @default(0.7)
  volumetricMaxDensity      Float   @default(0.5)
  volumetricDistanceAtten   Float   @default(2)

  /// Experience Editor v2, Rendering tab (PRD §22-33) — extends the SAME
  /// shared WebGPU render graph the Lighting tab built above (PRD §43),
  /// not a second pipeline. Every field the Rendering tab needs that
  /// already existed from before the v2 rebuild (bloomEnabled/
  /// bloomStrength/bloomRadius, lutEnabled/lutPreset/lutIntensity,
  /// depthOfFieldEnabled/depthOfFieldFocalLength/depthOfFieldBokehScale,
  /// exposure, toneMapping, antialiasEnabled, cameraAutoFocusEnabled) is
  /// reused as-is above/elsewhere in this model, not duplicated — these 9
  /// are the genuinely new columns. `antialiasEnabled` (default true,
  /// unchanged) now means real TRAA (temporal reprojection AA) + MSAA
  /// disabled at the renderer, replacing the old browser-MSAA-only
  /// behavior under the same toggle — a deliberate "upgrade the technique
  /// under an unchanged default" call, not a new opt-in (see
  /// RenderEngine.ts's own doc comment).
  /// Screen-space reflections (real vendored `SSRNode`, single-bounce
  /// mirror+roughness-blur mode — NOT the old, fully-removed 2026-08-13
  /// ad-hoc SSR/GTAO chain implicated in a real render-instability
  /// report; this is a from-scratch build on the new Phase-3-proven
  /// shared MRT graph). Off by default.
  ssrEnabled          Boolean @default(false)
  ssrIntensity        Float   @default(1)
  ssrMaxDistance      Float   @default(30)
  ssrThickness        Float   @default(0.5)
  ssrQuality          Float   @default(0.5)
  /// Real bloom-fed lens flare (`LensflareNode` — ghosts pivoting off the
  /// existing Bloom pass' bright-pass texture, so it has no visible effect
  /// unless `bloomEnabled` is also on; the Rendering panel's own UI
  /// enforces this dependency). Off by default.
  lensFlareEnabled    Boolean @default(false)
  lensFlareIntensity  Float   @default(1)
  /// Real per-pixel motion blur (`motionBlur()` TSL fn) sampling the
  /// scene's own MRT velocity buffer — genuine camera + object motion,
  /// not a fake radial blur. Off by default.
  motionBlurEnabled   Boolean @default(false)
  motionBlurIntensity Float   @default(1)

  /// Units Blocks & POI Layer PRD §5, §24 — appearance config for the
  /// dedicated `role=units` GLB slot's X-ray overlay, consumed by the
  /// single `src/lib/unitStatusVisuals.ts` registry (§5) that every
  /// status-color surface (unit page, listing, units bar, viewer blocks)
  /// reads from, so "sold = red" is enforced in exactly one place.
  /// `unitBlocksEnabled` is the master switch — off means the Units slot
  /// never loads even if one exists (an admin authoring-in-progress
  /// lever, same shape as `groundEnabled`/`shadowsEnabled`). Defaults
  /// preserve current behavior for every pre-existing project: none of
  /// them have a role=units slot yet, so these fields are inert until
  /// one is uploaded regardless of default value.
  unitBlocksEnabled                Boolean @default(true)
  unitBlocksStatusColorsEnabled    Boolean @default(true)
  unitBlocksXrayEnabled            Boolean @default(true)
  unitBlocksDefaultOpacity         Float   @default(0.18)
  unitBlocksHoverOpacity           Float   @default(0.25)
  unitBlocksSelectedOpacity        Float   @default(0.32)
  /// §12 — selected units keep their status color and gain a purple
  /// outline, instead of the old full-purple-fill SELECTED_COLOR
  /// replacement.
  unitBlocksSelectedOutlineEnabled Boolean @default(true)
  /// Outline thickness in SCREEN PIXELS (not world units), so a selected
  /// unit reads equally strongly whether the camera is orbiting the whole
  /// masterplan or pushed into a single floor. `1` reproduces the old
  /// hairline `THREE.LineSegments` look exactly, so existing projects are
  /// unchanged by this field's arrival.
  unitBlocksSelectedOutlineWidth   Float   @default(2.5)
  /// Selection "pop" — the selected unit's block is scaled up about its
  /// own bounding-box center (NOT its local origin, which for a GLB with
  /// baked transforms usually sits far away at the scene origin), so a
  /// click reads instantly even on a small unit inside a dense facade.
  /// Off by default: an existing project's selection look is unchanged
  /// until an admin turns it on. `1.05` is the subtle default the
  /// feature was asked for; the slider goes to 1.5 for masterplan-scale
  /// projects where 5% is invisible.
  unitBlocksSelectedScaleEnabled   Boolean @default(false)
  unitBlocksSelectedScale          Float   @default(1.05)
  /// Selection FILL color, the counterpart to the selection outline. §12
  /// deliberately keeps a selected unit's status color (a sold unit stays
  /// red while selected) — this is the opt-in override for projects that
  /// would rather a click repaint the block outright. Off by default, so
  /// §12's behavior is still what an unconfigured project gets. The
  /// outline keeps its own `unitColorSelected` color independently.
  unitBlocksSelectedFillEnabled    Boolean @default(true)
  unitColorSelectedFill            String  @default("#6b55f5")
  /// Per-selection X-ray: draws the SELECTED unit's block (and its
  /// outline) with depth testing off, so it stays visible through the
  /// facade from any orbit angle, while every other block still obeys the
  /// project-wide `unitBlocksXrayEnabled`. Independent of that switch —
  /// either one being on makes the selected block see-through-walls.
  unitBlocksSelectedXrayEnabled    Boolean @default(false)

  /// Units Blocks & POI Layer PRD §14 — "One Master POI Camera," one
  /// config per project (not per unit — see UnitMeshLinkV2.poiYawDeg for
  /// the one per-unit knob). `unitPoiCameraEnabled` defaults true: it's
  /// inert on every existing project (nothing calls focusUnit() without
  /// a role=units slot + raycast/list wiring, both new in this same
  /// PRD), so there's no existing-project behavior to preserve here the
  /// way there is for a toggle with a live renderer effect.
  unitPoiCameraEnabled            Boolean @default(true)
  unitPoiCameraFov                Float   @default(38)
  unitPoiCameraDistanceMultiplier Float   @default(3)
  unitPoiCameraHeightOffset       Float   @default(0.5)
  unitPoiTransitionMs             Int     @default(900)
  /// Stored per PRD §14; not yet wired to any real correction logic —
  /// same "real field, honestly not-yet-wired" precedent as several
  /// Interaction-tab toggles already in this schema.
  unitPoiAutoOcclusionCorrection  Boolean @default(false)

  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_3d_configs")
}

// `PlatformHdri` (a shared, platform-wide HDRI environment map — Task 2,
// Track A) removed entirely 2026-08-14 along with `Project3DConfig.hdriId`
// — the Sky/Water/Bloom/Clouds "Ocean" tab replaces the old HDRI/
// procedural-sky-preset background system with the physical SkyMesh as the
// only backdrop, so there's no longer a background mode for a Platform
// HDRI to apply to.

/// Admin's "3D Map Control" GLB placement — glbUrl now points at a real
/// Vercel Blob object (shared, public, permanent) instead of one browser's
/// IndexedDB, which is exactly the gap flagged when this feature shipped:
/// "nobody else sees Admin's own-browser upload".
model ProjectMapModel {
  projectId         String   @id
  glbUrl            String
  fileName          String
  fileSize          Int
  scale             Float    @default(1)
  rotationDeg       Float    @default(0)
  altitudeOffset    Float    @default(0)
  enabled           Boolean  @default(false)
  /// Hides the basemap's real 3D building footprint at this project's
  /// coordinates (see src/components/map/BuildingHider.ts) so the GLB
  /// replaces it cleanly instead of sitting alongside/inside it.
  hideBaseBuilding  Boolean  @default(false)
  /// Manually picked anchor point ("Pick Building to Remove" in
  /// MapModelEditor) used to resolve which real building footprint to hide,
  /// instead of always assuming it's the one nearest the project's own
  /// coordinates — the project pin doesn't always sit exactly on the
  /// footprint. Null falls back to the project's coordinates (legacy /
  /// not yet manually picked).
  hiddenBuildingLng Float?
  hiddenBuildingLat Float?
  updatedAt         DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_map_models")
}

/// Admin's "Project 3D Experience" detailed GLB — a second, separate upload
/// from ProjectMapModel above. That one is deliberately minimalistic (search
/// page performance, many projects rendered at once); this one is the real,
/// highly-detailed architectural model for a single project's own viewer
/// page (/project/[slug]), authored with individual `Unit_<number>` box
/// nodes baked in so Admin can link each one to a real Unit and have it
/// render as a colored, clickable availability box. Same real-Postgres-row
/// reasoning as ProjectMapModel: the URL and links must be shared/durable,
/// not one browser's local state.
model ProjectDetailModel {
  projectId      String   @id
  glbUrl         String
  fileName       String
  fileSize       Int
  scale          Float    @default(1)
  rotationDeg    Float    @default(0)
  altitudeOffset Float    @default(0)
  enabled        Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unitLinks UnitMeshLink[]

  @@map("project_detail_models")
}

/// One row per admin-confirmed link between a named `Unit_<number>` node
/// found inside a ProjectDetailModel's GLB and a real Unit. Node names are
/// whatever the 3D artist authored them as in the source file — not
/// guaranteed to match Unit.code — so this mapping is explicit, not inferred.
model UnitMeshLink {
  id        String   @id @default(cuid())
  projectId String
  meshName  String
  unitId    String
  updatedAt DateTime @updatedAt

  detailModel ProjectDetailModel @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@unique([projectId, meshName])
  @@map("unit_mesh_links")
}

// ---------------------------------------------------------------------------
// Versioned 3D asset pipeline (PRD_Admin_Mapbox_GLB, PRD_Admin_3D_Project_Experience)
// — Upload -> Validate -> Configure -> Preview -> Publish, with version
// history, draft/publish/rollback and an audit trail. Supersedes
// ProjectMapModel/ProjectDetailModel/UnitMeshLink above (see their comment).
// ---------------------------------------------------------------------------

enum ModelValidationStatus {
  ready
  warning
  blocked
}

enum ModelPublicationStatus {
  draft
  published
  archived
}

/// One immutable version of a project's lightweight search-map GLB
/// placement. Only one row per project may have publicationStatus
/// "published" at a time (enforced in the publish/rollback route handlers,
/// not a DB constraint — Postgres partial-unique indexes aren't modeled by
/// Prisma's schema syntax without raw SQL).
model MapModelVersion {
  id                String                 @id @default(cuid())
  projectId         String
  version           Int
  /// Nullable as of "save location before uploading a model" — a version
  /// can now exist as pure placement (latitude/longitude/altitude/heading/
  /// scale/hideBaseBuilding, all below) with no GLB at all, saved and even
  /// published in that state; the model itself gets attached later via the
  /// same PATCH route the placement fields already use. Every consumer
  /// (MapModelEditor.tsx, ProjectModelLayer.ts, the public Search Map) must
  /// treat a null publicAssetUrl as "positioned, no 3D model yet" — not an
  /// error state. Previously all four of these were required together at
  /// creation time (upload-first was the only order); zero behavior change
  /// for any version that already has a file.
  sourceAssetUrl    String?
  publicAssetUrl    String?
  fileName          String?
  fileSize          Int?
  triangleCount     Int?
  meshCount         Int?
  materialCount     Int?
  textureCount      Int?
  latitude          Float
  longitude         Float
  altitude          Float                  @default(0)
  heading           Float                  @default(0)
  scale             Float                  @default(1)
  minZoom           Int                    @default(13)
  fullDetailZoom    Int                    @default(16)
  maxZoom           Int?
  hideBaseBuilding  Boolean                @default(false)
  /// LEGACY as of the multi-building-pick pass — superseded by
  /// `hiddenBuildings` below (one point could never express "delete these
  /// 3 specific buildings"). Kept, unused, one-release safety net — same
  /// pattern as ProjectMapModel elsewhere in this schema.
  hiddenBuildingLng Float?
  hiddenBuildingLat Float?
  /// Array of `{ lng, lat, footprint: GeoJSON.Polygon | MultiPolygon | null,
  /// featureId?: string | number }` — each entry is one real building Admin
  /// picked to remove, with its footprint geometry captured once at pick
  /// time (not re-queried later, so it survives the public map being at a
  /// different zoom where the footprint might not be queryable). See
  /// src/components/map/BuildingHider.ts.
  hiddenBuildings   Json?
  validationStatus  ModelValidationStatus  @default(ready)
  validationIssues  Json?
  publicationStatus ModelPublicationStatus @default(draft)
  uploadedBy        String?
  publishedBy       String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  publishedAt       DateTime?

  /// Super Admin recycle bin — the version DELETE route now soft-deletes
  /// (Blob file kept) instead of a real prisma.delete(); a Super Admin
  /// hard-delete is what actually removes the Blob object.
  deletedAt DateTime?
  deletedBy String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@index([projectId, publicationStatus])
  @@map("map_model_versions")
}

/// A named "slot" a project's detailed 3D Experience can hang independent
/// GLBs off of — e.g. "Building" and "Surroundings" — so replacing one
/// doesn't touch the other. Admin-created (name is free text), always at
/// least one per project once any detail GLB exists (the migrate-detail-
/// model-slots.ts backfill creates a "Building" slot for every project
/// that already had DetailModelVersion rows before this table existed).
/// Units Blocks & POI Layer PRD §2 — what a slot's GLB actually contains,
/// resolved server- and engine-side instead of ever string-matching on
/// `DetailModelSlot.name` (an admin can rename "Building" to anything).
/// `custom` is the default for every slot created before this column
/// existed and for any future slot an admin adds beyond the 4 named
/// roles — same "honest, not silently reinterpreted" precedent as this
/// schema's other backward-compatible enum defaults.
enum DetailModelSlotRole {
  building
  units
  surroundings
  context
  custom
}

model DetailModelSlot {
  id        String              @id @default(cuid())
  projectId String
  name      String
  order     Int                 @default(0)
  role      DetailModelSlotRole @default(custom)
  createdAt DateTime            @default(now())

  /// Units Blocks & POI Layer PRD §3 — "Units GLB must inherit Building
  /// transform." When set, this slot's own position/rotation/scale
  /// (`DetailModelVersion` position/rotation/scale fields) are ignored by the
  /// engine in favor of copying the parent slot's live transform every
  /// frame, so Building and Units can never drift apart even as an admin
  /// edits Building's transform after Units was already placed. Nullable
  /// self-relation — most slots (Building itself, Surroundings, Context)
  /// have no parent and keep their own independent transform.
  transformParentSlotId String?
  transformParentSlot   DetailModelSlot?  @relation("SlotTransformParent", fields: [transformParentSlotId], references: [id], onDelete: SetNull)
  transformChildSlots   DetailModelSlot[] @relation("SlotTransformParent")

  project  Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions DetailModelVersion[]

  @@index([projectId])
  @@index([transformParentSlotId])
  @@map("detail_model_slots")
}

/// One immutable version of a project's detailed Three.js-experience GLB —
/// same versioning shape as MapModelVersion above, plus its own unit mesh
/// mapping (UnitMeshLinkV2) since mappings are meaningful per-version, not
/// per-project (a replacement GLB can rename/remove mesh nodes). Scoped to
/// one DetailModelSlot — `projectId` is kept alongside `slotId` too
/// (denormalized, same tolerance this schema already has elsewhere) so
/// existing `where: { projectId }` queries don't all need an extra join.
model DetailModelVersion {
  id                 String                 @id @default(cuid())
  projectId          String
  slotId             String
  version            Int
  sourceAssetUrl     String
  publicAssetUrl     String
  fileName           String
  fileSize           Int
  triangleCount      Int?
  meshCount          Int?
  materialCount      Int?
  textureCount       Int?
  scale              Float                  @default(1)
  /// Y-axis rotation, kept under its pre-existing name for backward
  /// compat with every row written before Experience Editor v2's Scene
  /// tab (PRD §5) added the other two axes below.
  rotationDeg        Float                  @default(0)
  /// Y-axis position, kept under its pre-existing name for the same
  /// reason as rotationDeg above.
  altitudeOffset     Float                  @default(0)
  /// Experience Editor v2, Scene tab (PRD §5) — full Position/Rotation.
  /// X/Z only here; Y reuses altitudeOffset/rotationDeg above rather than
  /// duplicating them under new names.
  positionX          Float                  @default(0)
  positionZ          Float                  @default(0)
  rotationXDeg       Float                  @default(0)
  rotationZDeg       Float                  @default(0)
  /// Experience Editor v2, Scene tab (PRD §5) Model switches. Defaults
  /// preserve current behavior for every pre-existing row (a model that
  /// exists always rendered, was always visible, always cast/received
  /// shadows once shadows existed). `selectable`/`transformLocked` are
  /// stored now but have no real backing system yet (viewport click-
  /// select/gizmo lands in a later phase) — the Scene tab UI marks them
  /// as such rather than pretending they do something today.
  modelEnabled       Boolean                @default(true)
  modelVisible       Boolean                @default(true)
  castShadow         Boolean                @default(true)
  receiveShadow      Boolean                @default(true)
  selectable         Boolean                @default(true)
  transformLocked    Boolean                @default(false)
  validationStatus   ModelValidationStatus  @default(ready)
  validationIssues   Json?
  /// Full node list for this version's GLB (not just Unit_* — see
  /// UnitMeshLinkV2 for that), computed server-side at upload time by
  /// glbValidate.ts. One entry per glTF node: { rzNodeId, name, meshIndex,
  /// parentRzNodeId, depth, isMesh, autoClassification }. Regenerated
  /// fresh on every new version, same lifecycle as validationIssues.
  sceneManifest      Json?
  /// Admin-authored classification/material overrides, keyed by rzNodeId:
  /// { rzNodeId, classification?, materialPreset?, colorHex?, roughness?,
  /// metalness?, visible?, carried? }[]. Carried forward by node NAME on a
  /// new version upload (same idea as UnitMeshLinkV2's carried/
  /// needs_review, hand-rolled here since this is a JSON blob, not a
  /// relational table with its own mappingStatus column).
  nodeOverrides      Json?
  /// The full ExperienceDocument snapshot for this revision (rewrite Track
  /// B, Phase 1 — src/lib/experienceDocument.ts's buildExperienceDocument()
  /// is the only writer). Additive: assembled FROM the fields above plus
  /// the project's Project3DConfig row at write time, not a replacement
  /// for them yet — every existing route/hook keeps reading those directly.
  /// Null for any version created before this column existed.
  experienceDocument Json?
  publicationStatus  ModelPublicationStatus @default(draft)
  uploadedBy         String?
  publishedBy        String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  publishedAt        DateTime?

  /// Super Admin recycle bin — same soft-delete-then-Blob-on-hard-delete
  /// pattern as MapModelVersion.
  deletedAt DateTime?
  deletedBy String?

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slot      DetailModelSlot  @relation(fields: [slotId], references: [id], onDelete: Cascade)
  unitLinks UnitMeshLinkV2[]

  @@unique([slotId, version])
  @@index([projectId, publicationStatus])
  @@index([slotId, publicationStatus])
  @@map("detail_model_versions")
}

/// Admin-confirmed link between a GLB mesh/node name and a real Unit,
/// scoped to one DetailModelVersion — PRD_Admin_3D_Project_Experience §19
/// "Mapping Version Behavior": a replacement version's route handler
/// copies forward links whose mesh name still exists in the new GLB
/// (mappingStatus "carried"), everything else starts "needs_review".
model UnitMeshLinkV2 {
  id                   String   @id @default(cuid())
  detailModelVersionId String
  meshName             String
  unitId               String
  /// mapped (admin-confirmed on this version) | carried (auto-copied from
  /// the prior published version, same mesh name) | needs_review (new/
  /// renamed mesh, or the carry-forward source was itself unconfirmed).
  mappingStatus        String   @default("mapped")
  mappedAt             DateTime @default(now())

  /// Units Blocks & POI Layer PRD §15-16 — "Each Unit only gets rotation."
  /// The one thing an admin authors per unit: which way its POI camera
  /// faces, in Building-local degrees (0/90/180/270 shown as N/E/S/W in
  /// the editor, stored as a free float for future flexibility). Combined
  /// with the project-wide `Project3DConfig.unitPoiCamera*` fields and the
  /// unit's own live bounding sphere at focusUnit()-time — deliberately
  /// NOT a full position/target pair per unit, per the PRD's "escape
  /// hatches only" framing below.
  poiYawDeg           Float   @default(0)
  /// Per-unit opt-out of the POI camera (e.g. a unit with no meaningful
  /// interior to frame). Does not affect status-color/X-ray rendering.
  poiEnabled          Boolean @default(true)
  /// Escape hatches only — 99% of units should need just `poiYawDeg`.
  /// Null means "use the project's unitPoiCameraDistanceMultiplier/
  /// HeightOffset as-is for this unit."
  poiDistanceOverride Float?
  poiHeightOverride   Float?

  detailModelVersion DetailModelVersion @relation(fields: [detailModelVersionId], references: [id], onDelete: Cascade)
  /// Units Blocks & POI Layer PRD §8 — was a bare, unvalidated String;
  /// now a real FK so a link can never point at a unitId that doesn't
  /// exist (or, combined with the route-level project check, one that
  /// belongs to a different project).
  unit               Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)

  /// PRD §8 — "one GLB block → one Unit, one Unit → one GLB block,"
  /// scoped per version (a later version can remap freely). The existing
  /// (detailModelVersionId, meshName) constraint below already prevented
  /// one mesh mapping to two units; this adds the missing other half.
  @@unique([detailModelVersionId, meshName])
  @@unique([detailModelVersionId, unitId])
  @@index([unitId])
  @@map("unit_mesh_links_v2")
}

/// Real audit trail for the versioned 3D pipeline's admin actions (upload,
/// publish, rollback, discard). Separate from the Dashboard-Architecture
/// pass's session-local Zustand `auditLog` slice, which has no real backend
/// actions to log against yet — an acknowledged, flagged inconsistency
/// rather than a forced unification of two different kinds of "admin
/// action" (one real/DB-backed, one still client-side mock).
model AuditLog {
  id          String   @id @default(cuid())
  actor       String
  action      String
  entityType  String
  entityId    String
  entityLabel String?
  createdAt   DateTime @default(now())

  // Super Admin control/audit pass — all additive/optional so every one of
  // the ~15 pre-existing logAuditEvent() call sites keeps compiling
  // untouched. This table now doubles as the version-history source: any
  // row carrying previousState/newState IS a restorable version, read back
  // by /api/admin/entities/[type]/[id]/restore-version instead of a
  // separate per-entity revision table.
  actorId       String?
  actorRole     String?
  reason        String?
  previousState Json?
  newState      Json?
  metadata      Json?
  ip            String?
  /// Set only on the final row written by a Super Admin hard-delete — the
  /// underlying record is gone, but this entry (with its previousState
  /// snapshot) is kept forever as the last trace of it.
  hardDeleted   Boolean @default(false)

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("admin_audit_log")
}

/// Forward-only log of real failures from the new admin write routes'
/// catch blocks (System Health panel). No retroactive backfill — errors
/// from before this table existed aren't recoverable.
model ApiErrorLog {
  id        String   @id @default(cuid())
  route     String
  message   String
  stack     String?
  actor     String?
  createdAt DateTime @default(now())

  @@index([route])
  @@map("admin_api_error_log")
}

/// Platform Settings' "Feature Flags" (PRD_ROZARIS_Admin §15) — real
/// DB-backed switches read server-side wherever a route/component actually
/// branches on them (see each flag's own `checkedBy` note below). Only
/// global on/off for now — no per-user or percentage rollout, since
/// nothing in the app has audience segmentation to hang that off of yet.
/// `key` is free-text (not an enum) so ops can add a flag without a
/// migration; each read site treats an unknown/missing key as `enabled`
/// (fail open to current behavior) via `isFeatureEnabled()`.
model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(true)
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@map("feature_flags")
}

/// Account & Profile System PRD v1.0 §"Admin can edit everything from the
/// console panel; can make some fields 'Must fill' or 'Only by choice'" —
/// admin-configurable per-field Required/Optional override for account
/// profile forms. Same fail-open/override convention as `FeatureFlag`: the
/// authoritative default per key lives in `src/lib/fieldPolicies.ts`
/// (`FIELD_POLICIES`), a row here only exists once an admin has actually
/// changed a field away from its default, and a missing row falls back to
/// that default (never "not required" by omission). `key` is free-text
/// (e.g. "standard_user.phone", "business_publisher.website") so a new
/// field can be added to the registry without a migration.
model FieldPolicy {
  key       String   @id
  required  Boolean
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("field_policies")
}

/// Platform CMS's "SEO titles / SEO descriptions" (PRD_ROZARIS_Admin §14)
/// — a real override read by `generateMetadata()` on a curated set of
/// marketing pages (see `src/lib/pageSeo.ts` for the registry of which
/// `page` keys exist and what each page's own hardcoded fallback is). A
/// missing row means "use the page's own hardcoded `<title>`/description",
/// same fail-open convention as `FeatureFlag`.
model PageSeoOverride {
  page        String   @id
  title       String?
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@map("page_seo_overrides")
}

/// Search Engine Control's "search ranking weights" (PRD_ROZARIS_Admin
/// §13) — a single-row config (`id: "default"`) admin-adjustable without a
/// deploy, applied by `src/lib/searchRanking.ts`'s `computeRankScore()` to
/// real `Listing` fields wherever the "recommended" sort is used
/// (`getVisibleListings` in `src/lib/filtering.ts`). Every weight here maps
/// to a real, computable signal — no "reported" weight, since nothing in
/// the app produces a real per-listing report yet (ModerationTab is still
/// seeded from mock cases); adding a weight with nothing real behind it
/// would just be a fake control.
model SearchRankingConfig {
  id                      String   @id @default("default")
  premiumWeight           Int      @default(30)
  freshListingWeight      Int      @default(8)
  verifiedPublisherWeight Int      @default(10)
  completeInfoWeight      Int      @default(5)
  threeDProjectWeight     Int      @default(6)
  poorDataWeight          Int      @default(-10)
  updatedAt               DateTime @updatedAt
  updatedBy               String?

  @@map("search_ranking_config")
}

// ---------------------------------------------------------------------------
// Moderation — real user-submitted reports, replacing ModerationTab's
// hardcoded seedCases() (3 mock cases pointed at fixed mockData rows).
// `reporterUserId` is deliberately a bare string, no `@relation` to User —
// same "reference id, not a foreign key" convention `Listing.duplicateOfId`
// already uses, so this doesn't need a matching relation field on User.
// ---------------------------------------------------------------------------

enum ModerationEntityType {
  listing
  project
}

enum ModerationCaseType {
  duplicate
  suspicious_price
  misleading_media
  wrong_location
  spam_fraud
  copyright
  user_report
}

enum ModerationStatus {
  pending
  actioned
  dismissed
}

model ModerationReport {
  id             String               @id @default(cuid())
  entityType     ModerationEntityType
  entityId       String
  caseType       ModerationCaseType
  note           String?
  status         ModerationStatus     @default(pending)
  reporterUserId String?
  createdAt      DateTime             @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?
  resolution     String?

  @@index([entityType, entityId])
  @@index([status])
  @@map("moderation_reports")
}

// ---------------------------------------------------------------------------
// Publisher leads
// ---------------------------------------------------------------------------

/// PRD_ROZARIS_User_Types §4 "Leads" pipeline — New→Contacted→Qualified→
/// Viewing→Negotiation→Won→Lost. Corrected from a stale 6-value enum
/// (new/contacted/viewing/negotiating/closed/archived) that never matched
/// the pipeline the Leads tab UI/i18n actually implements — found wiring
/// the tab onto real data for the first time (0 real rows existed yet, so
/// nothing was migrated away from).
enum LeadStatus {
  new
  contacted
  qualified
  viewing
  negotiating
  won
  lost
}

model LeadItem {
  id          String     @id @default(cuid())
  publisherId String
  listingId   String?
  projectId   String?
  source      String
  status      LeadStatus @default(new)
  /// Free-text follow-up notes an assignee leaves (PRD_ROZARIS_User_Types
  /// §4 "Lead detail supports notes, assignment and follow-up") — was
  /// Zustand-local only (lost on a different device/browser); now a real
  /// column so the Leads tab's notes persist like everything else.
  notes       String?
  createdAt   DateTime   @default(now())

  publisher Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  listing   Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("leads")
}

model LeadStatusOverride {
  id     String     @id @default(cuid())
  userId String
  leadId String     @unique
  status LeadStatus

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lead_status_overrides")
}

// ---------------------------------------------------------------------------
// Platform settings — singleton row (id always "singleton").
// ---------------------------------------------------------------------------

model PlatformSettings {
  id           String   @id @default("singleton")
  eurToAllRate Float    @default(97)
  updatedAt    DateTime @updatedAt

  @@map("platform_settings")
}

// ---------------------------------------------------------------------------
// Analytics events — one generic append-only log, not per-entity counter
// columns. A counter column can only ever answer "how many total"; a real
// event row (with a timestamp) also answers "how many this week", "on
// which day", trends over time — real analytics, not just a number.
// Reused for both content (Listing/Project view + WhatsApp/call clicks —
// visible to that post's owner and Admin) and Advertisement (impression/
// click tracking for the Admin Advertising dashboard) rather than two
// near-identical tables.
// ---------------------------------------------------------------------------

model AnalyticsEvent {
  id         String   @id @default(cuid())
  entityType String // "listing" | "project" | "ad"
  entityId   String
  eventType  String // "view" | "whatsapp_click" | "call_click" | "impression" | "click"
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, eventType])
  @@index([entityType, entityId, createdAt])
  @@map("analytics_events")
}

// ---------------------------------------------------------------------------
// Advertising — a small, fixed set of front-page banner slots Admin can
// point at any image + destination URL. Deliberately NOT a general N-slot
// system: 3 fixed named positions, matching what was actually asked for.
// ---------------------------------------------------------------------------

model Advertisement {
  id        String   @id @default(cuid())
  /// "front_page_banner_1" | "front_page_banner_2" | "front_page_banner_3"
  /// — one row per position; @unique so a save is a real upsert-by-slot,
  /// never a second competing row for the same banner.
  position  String   @unique
  title     String // Admin's own reference label — never shown to visitors.
  imageUrl  String
  linkUrl   String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("advertisements")
}

// ---------------------------------------------------------------------------
// Environment Presets — a reusable, named "look" (Sun & Sky, Fog & Haze,
// Clouds, Water, Lens Flare/Bloom, Tone Mapping/LUT) an admin can save from
// one project's Experience Editor and apply to ANY other project. Global
// (no projectId): the whole point is cross-project reuse, unlike every
// other Environment/Rendering field, which lives on the per-project
// Project3DConfig singleton. `config` is a validated JSON snapshot of
// exactly the field set src/lib/environmentPresetFields.ts defines —
// deliberately excludes camera, quality/performance, ground, unit colors,
// Sections, and Shadows/GI/DoF/SSR/Motion-Blur (those are tuned to each
// project's own GLB scale/branding, not portable).
// ---------------------------------------------------------------------------

model EnvironmentPreset {
  id        String   @id @default(cuid())
  /// Admin-chosen, unique so the Presets tab's picker never shows two
  /// indistinguishable entries — a rename/create that collides is a real
  /// 409, not a silent duplicate.
  name      String   @unique
  config    Json
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("environment_presets")
}

// ---------------------------------------------------------------------------
// Multi-Channel Publishing — Phase 2 (Data foundation). See the
// "rozaris-multichannel-publishing-prd" memory for the full architecture:
// one Project/digital-twin publishes through many independently controlled
// `ProjectPublishTarget`s (Rozaris marketplace, white-label client embeds,
// kiosks) instead of duplicated projects per client. `ViewerRelease` is the
// immutable compiled snapshot a target points at — deliberately separate
// from the live-editable `Project3DConfig`/`DetailModelVersion` rows the
// Experience Configurator writes to, so an admin can keep tuning lighting
// on a draft while every already-deployed target keeps serving its last
// released manifest untouched. The release COMPILER (turning
// Project3DConfig + DetailModelVersions + UnitMeshLinkV2 into `manifest`)
// is Phase 3, not added here — this pass is schema + CRUD only, nothing
// reads or writes a real `manifest` yet (`ready`/`archived` on
// ViewerReleaseStatus, and manifest's contents, are inert until then).
// ---------------------------------------------------------------------------

enum ViewerReleaseStatus {
  draft
  ready
  archived
}

/// One immutable compiled snapshot of a project's 3D experience — what a
/// `ProjectPublishTarget` actually serves in production. `manifestHash`
/// lets a target cheaply confirm "am I still serving the latest" without
/// re-hashing a potentially large JSON blob client-side.
model ViewerRelease {
  id            String              @id @default(cuid())
  projectId     String
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version       Int
  status        ViewerReleaseStatus @default(draft)
  schemaVersion Int                 @default(1)
  manifest      Json
  manifestHash  String
  createdBy     String?
  createdAt     DateTime            @default(now())
  validatedAt   DateTime?
  archivedAt    DateTime?

  publishTargets ProjectPublishTarget[]

  @@unique([projectId, version])
  @@index([projectId, status])
  @@map("viewer_releases")
}

enum PublishTargetType {
  marketplace
  embed
  custom_domain
  kiosk
}

enum PublishTargetStatus {
  draft
  active
  suspended
  expired
}

/// Where a Project's digital twin is actually deployed — the PRD's core new
/// concept. One Project can have many of these (ROZARIS marketplace + N
/// white-label client sites + kiosks) all pointing at the SAME Unit rows
/// and either a shared or independently-pinned `ViewerRelease`, never a
/// duplicated project. `publicKey` is the only identifier ever exposed to a
/// browser (embed iframe src, bootstrap requests) — deliberately opaque and
/// unguessable, never an administrative credential.
model ProjectPublishTarget {
  id String @id @default(cuid())

  /// Opaque public locator, crypto.randomBytes-generated — see
  /// src/lib/publishing/publicKey.ts. Never sequential/guessable, since
  /// this is the one identifier a public embed URL/bootstrap API ever sees.
  publicKey String @unique

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Denormalized alongside projectId (same tolerance this schema already
  /// has elsewhere, e.g. DetailModelVersion.projectId) — lets a future
  /// Client Portal query "every target across every one of my projects" in
  /// one indexed lookup instead of joining through Project every time.
  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  type   PublishTargetType
  status PublishTargetStatus @default(draft)

  /// Admin-facing label only ("ABC Construction Website") — never shown to
  /// an actual visitor, who sees `branding` below instead.
  name String

  activeReleaseId String?
  activeRelease   ViewerRelease? @relation(fields: [activeReleaseId], references: [id], onDelete: SetNull)

  /// `type: custom_domain` targets only, e.g. "abcconstruction.al".
  /// Verification/DNS wiring is Phase 10 (Enterprise); the column exists
  /// now so the admin CRUD shape doesn't need a breaking change later.
  customDomain String?
  /// CSP `frame-ancestors` + Origin-header allowlist for `type: embed`,
  /// e.g. ["https://abcconstruction.al", "https://www.abcconstruction.al"].
  /// Enforced starting Phase 5 (`/embed/[publicKey]`); stored now so a
  /// target can be fully configured before that route exists.
  allowedOrigins String[]

  /// Presentation overlay only — logo/colors/CTA copy/feature toggles (PRD
  /// §42's shape). Deliberately never duplicates Unit price/availability;
  /// see PublishTargetUnitOverride below for the one thing that DOES vary
  /// per channel.
  branding        Json?
  viewerOverrides Json?

  licenseStartsAt DateTime?
  licenseEndsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unitOverrides PublishTargetUnitOverride[]

  @@index([projectId])
  @@index([publisherId])
  @@map("project_publish_targets")
}

/// Per-channel presentation override for a single Unit — NOT a duplicate of
/// the Unit row. Price/availability/etc. stay single-source-of-truth on
/// `Unit` itself (PRD §11 "channel overrides"). A row here means "on this
/// one target, show this unit differently"; no row means "show the
/// channel's normal defaults."
model PublishTargetUnitOverride {
  id String @id @default(cuid())

  publishTargetId String
  publishTarget   ProjectPublishTarget @relation(fields: [publishTargetId], references: [id], onDelete: Cascade)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  visible     Boolean @default(true)
  showPrice   Boolean @default(true)
  customPrice Float?
  ctaType     String?
  ctaUrl      String?

  @@unique([publishTargetId, unitId])
  @@map("publish_target_unit_overrides")
}

/// Cheap "did anything change" counter for the live inventory endpoint
/// (Phase 6) — a viewer will poll this instead of re-fetching/diffing every
/// unit on a timer. One row per Project, created lazily on first bump
/// rather than backfilled for every existing project up front.
model ProjectInventoryState {
  projectId String   @id
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revision  BigInt   @default(0)
  updatedAt DateTime @updatedAt

  @@map("project_inventory_states")
}

// ---------------------------------------------------------------------------
// Multi-Channel Publishing — Phase 8 (external inventory ingestion). PRD §20:
// "Google Sheets must be treated as an external editor, not your database."
// `InventoryConnector` + `InventorySyncRun` are deliberately provider-
// agnostic — `google_sheets`/`api`/`manual` all funnel through the same
// validate → match-by-code → diff → write → bump-revision → audit engine
// (src/lib/integrations/inventorySync.ts). Only `google_sheets` needs a
// real fetch step (src/lib/integrations/googleSheets.ts) this environment
// has no way to test end-to-end against a real sheet (no OAuth/service-
// account credential, same honesty as KYC/OTP/Upstash elsewhere in this
// app) — `manual` (rows supplied directly via the admin API) exercises the
// exact same engine and IS fully real-DB-verified.
// ---------------------------------------------------------------------------

enum InventoryConnectorType {
  google_sheets
  api
  manual
}

enum ConnectorStatus {
  active
  paused
  error
}

model InventoryConnector {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type   InventoryConnectorType
  status ConnectorStatus       @default(active)

  /// `type: google_sheets` — the sheet id from its URL. Null for other types.
  externalResourceId String?
  /// Deliberately unused/inert — this environment has no secrets manager to
  /// point it at, and the only fetch path implemented (public CSV export)
  /// needs no credential at all. Kept so the shape doesn't need a breaking
  /// change once a real OAuth/service-account flow exists.
  credentialsRef String?

  configuration Json?
  columnMapping Json?

  lastSyncAt           DateTime?
  lastSuccessfulSyncAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  syncRuns InventorySyncRun[]

  @@index([projectId])
  @@map("inventory_connectors")
}

/// One row per sync attempt — PRD §23's own worked example ("I changed
/// apartment 44 to sold yesterday but it's showing available... A-044
/// ERROR: invalid status") is exactly what `errors` here makes answerable.
model InventorySyncRun {
  id String @id @default(cuid())

  connectorId String
  connector   InventoryConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  /// "success" | "partial" | "error" — free string, not an enum, matching
  /// this schema's existing tolerance for small closed-ish string sets
  /// checked in application code (e.g. Unit.status) rather than the DB.
  status String

  /// sha256 of the raw row payload — PROVENANCE only ("was this the same
  /// sheet as last time?"). It deliberately does NOT gate writes: computed
  /// from the sheet alone, it cannot see whether the units have drifted
  /// away from it, so using it as a write gate made every sync after a
  /// hand edit a silent no-op. PRD §24 step 11's idempotency is satisfied
  /// instead by the engine's per-row diff, which writes only fields that
  /// actually differ. Null for a run that failed before any rows were read.
  sourceHash String?

  rowsRead     Int
  rowsChanged  Int
  rowsRejected Int
  errors       Json?

  startedAt  DateTime
  finishedAt DateTime?

  @@index([connectorId, startedAt])
  @@map("inventory_sync_runs")
}

// ---------------------------------------------------------------------------
// Multi-Channel Publishing — Phase 9 (client-side project permissions). PRD
// §27-29: "Your existing Publisher system is the correct tenant
// foundation... don't introduce an unrelated Tenant table" + "add
// project-level permissions." `OrganizationMembership` (existing) already
// scopes a team member's role across an ENTIRE Publisher/org; this adds the
// narrower "which specific projects can this person touch, and with what
// access" layer on top — e.g. a Sales Agent who should only ever see one
// tower's inventory+leads, not the whole company's portfolio. A Publisher
// owner/org-admin (or a Rozaris admin) always has full access to every one
// of their own projects regardless of this table (see
// `requireProjectPermission()`, src/lib/permissions/projectAccess.ts) — a
// row here is only needed to grant a REGULAR org member (agent/
// content_editor/viewer, none of which imply project access on their own)
// scoped reach into one specific project. Deliberately admin-managed for
// now (`/api/admin/projects/[projectId]/members`), not yet a Publisher
// self-service flow — that's a natural follow-on using the same
// `requireOrgRole()` gate Business Teams already has, not built this pass.
// ---------------------------------------------------------------------------

enum ProjectMemberRole {
  project_admin
  inventory_manager
  sales_manager
  analytics_viewer
}

model ProjectMembership {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role ProjectMemberRole

  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@map("project_memberships")
}

// ---------------------------------------------------------------------------
// Multi-Channel Publishing — Phase 10 (Enterprise: scoped API credentials).
// PRD §50-51: "Client API credentials... Never store plain keys." Real
// prefix+hash storage (bcrypt, already a dependency this app's own
// password hashing uses — see src/auth.ts) — the plaintext key is shown to
// the admin/publisher exactly once at creation time and never persisted or
// retrievable again, same handling a password reset flow would use.
// Deliberately scoped to inventory/prices/leads read/write — PRD §50's own
// "Never: project3d:write, admin:*" is enforced by the `scopes` allowlist
// below, not left to caller discipline.
// ---------------------------------------------------------------------------

enum ClientApiScope {
  inventory_read
  inventory_write
  prices_write
  leads_read
}

model ClientApiCredential {
  id String @id @default(cuid())

  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  /// Admin/publisher-facing label ("Skyline CRM integration"), not shown
  /// to API callers.
  name String

  /// First 8 chars of the real key, kept in the clear so a credentials list
  /// UI can show "rzk_a1b2c3d4••••••••" without ever re-deriving or storing
  /// the full value — the same partial-reveal pattern most API-key
  /// products use.
  keyPrefix String
  /// bcrypt hash of the full key — verified the same way
  /// `Account.password`/`User.passwordHash` are (bcrypt.compare), never
  /// reversed.
  keyHash String

  scopes ClientApiScope[]

  expiresAt DateTime?
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([publisherId])
  @@map("client_api_credentials")
}
