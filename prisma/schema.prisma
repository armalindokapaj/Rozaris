// ROZARIS backend schema — see MEMORY note "rozaris-backend-plan" for the
// phased rollout this belongs to. Mirrors src/lib/types.ts (the PRD data
// model) wherever a domain is moving from Zustand/localStorage to a real,
// shared, multi-user store.
//
// Scope note (deliberate, per product decision): the public browse/search
// catalog (Listing/Project *reads*) stays on src/lib/mockData.ts for now —
// that full catalog migration + geo search is a later phase. What lives here
// already is: real auth, the publisher "submit a listing/project" ->
// admin "approve/publish" workflow, and every per-user domain that used to
// be private to one browser's localStorage (saved items, follows,
// notifications, messaging, construction-timeline requests, the two 3D
// admin configs). Newly-submitted Listings/Projects are real rows from day
// one, they just aren't merged into the public search results yet.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Vercel Postgres (Neon) exposes both a pooled and a direct connection —
  // migrations need the direct one to avoid pgbouncer issues.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

enum UserRole {
  buyer
  publisher
  admin
}

enum PublisherType {
  private_owner
  agency
  developer
}

/// §9.1 "Business — Not submitted / Pending / Verified / Rejected /
/// Reverify required". `reverify_required` is set automatically when a
/// verified organization's legal identity changes (§9.3
/// "Re-verification triggers"), not by an admin action.
enum PublisherVerificationStatus {
  not_submitted
  pending
  verified
  rejected
  reverify_required
}

enum DeveloperStatus {
  not_applicable
  pending
  verified
}

/// Account-level access state, enforced at real sign-in (src/auth.ts's
/// authorize()) — Super Admin control/audit pass. `restricted` is reserved
/// for a future lighter-touch state; only suspended/disabled currently
/// block sign-in.
enum UserStatus {
  active
  restricted
  suspended
  disabled
}

/// Account & Profile System PRD v1.0 §9.1 "Internal verification
/// dimensions — Identity". `not_required` (not `unverified`) is the
/// default so an ordinary buyer who never asked for a "Verified
/// Publisher" badge doesn't read as having failed anything.
enum IdentityVerificationStatus {
  not_required
  pending
  verified
  failed
  expired
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  phone         String?   @unique
  passwordHash  String?
  name          String
  role          UserRole  @default(buyer)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  // Super Admin control/audit pass (PRD_ROZARIS_Admin §12 "Account
  // controls", §14 "Change Admin permissions"). adminScopes values mirror
  // the PRD's "Future Admin permission scopes" table — free-text (not an
  // enum) so a new scope can be granted without a migration:
  // listing_reviewer | publisher_verification | 3d_manager |
  // content_manager | finance_admin | support_admin.
  status          UserStatus @default(active)
  statusReason    String?
  statusChangedAt DateTime?
  statusChangedBy String?
  /// Time-bound "idle" — an admin-set restriction (e.g. `status:
  /// "restricted"`) that auto-expires instead of needing a second admin
  /// action to lift. `null` means whatever `status` is set to is
  /// indefinite (the original behavior, unchanged). Checked, not enforced
  /// by a background job — `isUserIdle()` (src/lib/moderation.ts) compares
  /// against `now()` on every write-gated request.
  statusUntil     DateTime?
  superAdmin      Boolean    @default(false)
  adminScopes     String[]   @default([])
  deletedAt       DateTime?
  deletedBy       String?

  // Auth.js
  accounts Account[]
  sessions Session[]

  // --- Account & Profile System PRD v1.0 (2026-08-15) §4 "Standard User
  // Profile" / §5 "Personalization" / §10 "Privacy, Security & Consent" ---
  // Additive onto the existing `name`/`email`/`phone` — `name` stays as the
  // legacy display value every pre-existing read site (messaging, admin
  // tables, seed data) still relies on; firstName/lastName are the new
  // structured identity fields, kept in sync from account settings only.
  // Whether each of these is required at all is NOT hardcoded here — it's
  // governed by the admin-configurable `FieldPolicy` table (see
  // src/lib/fieldPolicies.ts), enforced server-side in
  // /api/account/profile's PATCH handler.
  firstName              String?
  lastName               String?
  country                String?
  preferredLanguage      String?
  preferredCurrency      String?
  preferredContactMethod String?
  cityLocationId         String?
  cityLocation           Location? @relation("UserCityLocation", fields: [cityLocationId], references: [id], onDelete: SetNull)
  phoneVerifiedAt        DateTime?
  /// §10.2 "Marketing consent — Explicit, revocable, versioned."
  marketingConsent       Boolean   @default(false)
  marketingConsentAt     DateTime?
  termsAcceptedAt        DateTime?
  termsVersion           String?

  // §9 "Verification & Trust — Identity" — no real document-upload/KYC
  // provider in this environment (same "no paid third-party" constraint
  // noted on phone OTP in src/auth.ts), so this is a real self-service
  // request + real admin manual review workflow, not automated
  // verification. `identityNote` is a free-text declaration the requester
  // submits for the admin to review against, not a stored document.
  identityVerificationStatus IdentityVerificationStatus @default(not_required)
  identitySubmittedAt        DateTime?
  identityReviewedAt         DateTime?
  identityReviewedBy         String?
  identityRejectionReason    String?
  identityNote               String?

  // Buyer-side profile fields (PRD_User) — null for publisher/admin accounts.
  buyerPreferences Json?

  // A publisher-role user owns exactly one Publisher org record. A
  // publisher-role user who does NOT own one instead belongs to someone
  // else's via `organizationMemberships` (§8) — resolved into the same
  // session `publisherId` either way, see src/auth.ts's authorize().
  publisher               Publisher?
  organizationMemberships OrganizationMembership[]

  savedItems               SavedItem[]
  savedSearches            SavedSearch[]
  follows                  Follow[]
  recentlyViewed           RecentlyViewedEntry[]
  notifications            Notification[]
  sentConversationsAsBuyer Conversation[]        @relation("BuyerConversations")
  messages                 Message[]
  leadStatusOverrides      LeadStatusOverride[]
  /// Multi-Channel Publishing PRD Phase 9 — see ProjectMembership's own
  /// doc comment.
  projectMemberships       ProjectMembership[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Canonical Location System — user's explicit 2026-08-15 requirement: every
// Albanian location has one official name and one permanent ID; nothing in
// ROZARIS stores a location as free text. See MEMORY note "rozaris-
// controlled-taxonomy-spec" for the full spec this schema is the first slice
// of.
//
// Hierarchy — user's 2026-08-21 correction: Albania's real estate taxonomy
// doesn't need Country/County/Administrative-Unit levels (Albania's own
// admin hierarchy has counties, but nothing on this platform ever searches
// or filters by one, so it was dead structure). `Municipality` (Bashkia) is
// now the top of the tree (`parentId: null`), same self-referential
// `Location` model as before, just shallower:
//   Municipality -> City OR Village -> Neighborhood
//   Municipality -> Neighborhood (directly, for a municipality/village with
//     no distinct city center — e.g. Himarë)
// `Village` covers a unit whose real address is a village, not a city
// neighborhood — it's a sibling of City under the same Municipality, not a
// City subtype. Enforced server-side (`POST`/`PATCH /api/admin/locations*`),
// not just a UI convention.
//
// Rollout note: `Project.locationId` sits alongside the existing
// `city`/`neighborhoodId` string columns (Project hasn't gone through the
// Property/Listing/Transaction split below — it's still one flat row).
// `Listing`'s own location fields moved off it entirely in that split —
// see the schema-header note above `Property` further down. Seeded from
// mockData.neighborhoods by scripts/seed-locations.ts, which gives the
// seeded Location rows the SAME ids mockData already uses (`n-blloku` etc.)
// so existing data lines up with zero drift. The public catalog itself
// still reads mockData.ts (see this file's header) — real Listing/Project
// rows are the publisher-submit -> admin-approve pipeline only, not yet
// merged into public search.
// ---------------------------------------------------------------------------

enum LocationType {
  municipality
  city
  village
  neighborhood
}

model Location {
  id               String       @id
  parentId         String?
  type             LocationType
  /// The one official name — what publishers/admins see in the dropdown
  /// and what every display surface renders. Never user-editable free text.
  officialName     String
  slug             String       @unique
  latitude         Float?
  longitude        Float?
  /// GeoJSON Polygon/MultiPolygon — lets map filtering (and someday
  /// coordinate-inside-boundary validation) be geometric instead of
  /// relying on text/point matching alone.
  boundaryGeometry Json?
  isActive         Boolean      @default(true)
  sortOrder        Int          @default(0)
  createdAt        DateTime     @default(now())

  parent   Location?       @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Location[]      @relation("LocationHierarchy")
  aliases  LocationAlias[]

  projects          Project[]
  usersWithThisCity User[]     @relation("UserCityLocation")
  properties        Property[]

  @@index([parentId])
  @@index([type])
  @@map("locations")
}

/// Search-matching only — "Tiran"/"Tiranë"/"Tirona" all resolve to
/// `CITY-TIRANA` here, but the value ROZARIS ever stores against a
/// Listing/Project is always the canonical `locationId`, never the alias
/// text itself.
model LocationAlias {
  id         String @id @default(cuid())
  alias      String
  locationId String

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([alias, locationId])
  @@index([alias])
  @@map("location_aliases")
}

// ---------------------------------------------------------------------------
// Publishers, Listings, Projects — the "submit -> admin approve -> publish"
// pipeline (public browse still reads mockData.ts; see file header).
// ---------------------------------------------------------------------------

model Publisher {
  id       String        @id @default(cuid())
  slug     String        @unique
  name     String
  type     PublisherType
  verified Boolean       @default(false)
  logoUrl  String?
  phone    String
  whatsapp String?
  bio      String?

  // Account & Profile System PRD v1.0 §9 "Business Publisher &
  // Organization Profile" — additive fields the original Publisher model
  // (a listing/project owner, not yet a real company profile) never had.
  // `Publisher` doubles as the PRD's "Organization" entity rather than a
  // parallel model — renaming it would touch every Listing/Project/LeadItem
  // read site for no functional gain; a `type: private_owner` row simply
  // never populates these.
  legalName          String?
  registrationNumber String?
  businessAddress    String?
  companyEmail       String?
  website            String?

  // §9.1 "Business" + "Developer status" verification dimensions.
  // `verified` (above) is kept as the single DERIVED public flag every
  // pre-existing read site (badges, PublishersTab, the old VerificationTab
  // queue) already reads — it's set true only when `verificationStatus`
  // transitions to `verified` (see /api/admin/publishers/[id] PATCH and
  // /api/business/organization PATCH's re-verification trigger), so none
  // of those existing sites needed to change for this to be real instead
  // of a bare admin-toggled boolean.
  verificationStatus          PublisherVerificationStatus @default(not_submitted)
  verificationSubmittedAt     DateTime?
  verificationReviewedAt      DateTime?
  verificationReviewedBy      String?
  verificationRejectionReason String?
  /// Only meaningful when `type: developer` — separate from generic
  /// business verification per §9.1's own "Developer status — Not
  /// applicable / Pending / Verified — Separate from generic business
  /// verification".
  developerStatus             DeveloperStatus             @default(not_applicable)

  /// "Restrict publishing" (PRD §6 Publisher Admin actions) — prevents new
  /// publication while preserving traceability. Distinct from the owning
  /// User's `status` (that blocks sign-in entirely); this blocks only new
  /// publish actions.
  restricted       Boolean   @default(false)
  restrictedReason String?
  /// Time-bound restriction — same pattern as `User.statusUntil`. `null`
  /// with `restricted: true` means indefinite (the original behavior).
  restrictedUntil  DateTime?
  deletedAt        DateTime?
  deletedBy        String?

  ownerUserId String @unique
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  listings Listing[]
  projects Project[]
  leads    LeadItem[]

  /// Multi-Channel Publishing PRD Phase 2 — denormalized alongside
  /// ProjectPublishTarget.projectId, see that model's own doc comment.
  publishTargets ProjectPublishTarget[]
  /// Phase 10 — see ClientApiCredential's own doc comment.
  apiCredentials ClientApiCredential[]

  // §8 "Business Teams, Roles & Permissions" — every member is its own
  // real ROZARIS account (never a shared login), joined via an
  // email-addressed invitation. The owner itself is represented by
  // `ownerUserId` above, not a membership row — resolving "who can act as
  // this Publisher" is `ownerUserId` UNION active `memberships`.
  memberships OrganizationMembership[]
  invitations OrganizationInvitation[]

  createdAt DateTime @default(now())

  @@map("publishers")
}

/// §8.2 "Recommended business roles" — deliberately a bounded enum (not a
/// free-text scope string like `User.adminScopes`) since these gate real
/// per-route permission checks (`requireOrgRole()`), not just UI labels.
/// Collapsed from the PRD's 7-row table to the distinctions that actually
/// change behavior today: `owner`/`admin` can manage the team + company
/// profile, everyone else can't — `project_manager`/`sales_manager` (scoped
/// to assigned inventory) is real future work, not yet enforced anywhere.
enum OrganizationRole {
  owner
  admin
  agent
  content_editor
  viewer
}

/// §8 "Business Teams, Roles & Permissions" — one real ROZARIS account
/// (`userId`) with scoped access into one `Publisher` (never a shared
/// login). `status` follows §8.3's "Invited / Active / Suspended /
/// Removed" — a row is only ever created once an invitation is accepted
/// (see `OrganizationInvitation`), so it starts `active`, not `invited`.
model OrganizationMembership {
  id          String           @id @default(cuid())
  publisherId String
  userId      String
  role        OrganizationRole
  status      String           @default("active")
  invitedBy   String?
  createdAt   DateTime         @default(now())

  publisher Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([publisherId, userId])
  @@map("organization_memberships")
}

/// §14.4 "Business invitation" flow — email-addressed (not user-id
/// addressed, since the invitee may not have a ROZARIS account yet).
/// `status: pending` rows are what `GET /api/account/invitations` matches
/// against the signed-in user's own verified email; accepting converts one
/// into an `OrganizationMembership` row (see
/// `POST /api/account/invitations/[id]/accept`).
model OrganizationInvitation {
  id          String           @id @default(cuid())
  publisherId String
  email       String
  role        OrganizationRole
  status      String           @default("pending")
  invitedBy   String
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  publisher Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  @@unique([publisherId, email])
  @@map("organization_invitations")
}

enum ListingStatus {
  /// No confirmed location (see `Listing.locationConfirmed`) — the
  /// publisher never dropped a real pin, and no admin has chosen to
  /// approve it without one. Never shown publicly; the publisher's own
  /// dashboard is the only place a draft appears, with a prompt to add a
  /// location and resubmit.
  draft
  pending // submitted, awaiting admin approval — not yet live anywhere
  active
  sold
  rented
  expired
  suspended
  archived
  /// Approval Center's "Reject" verdict on a `pending` submission —
  /// distinct from `suspended` (was live, taken down) and `archived`
  /// (force-unpublished by an admin action). Always carries a `reason`
  /// (enforced in the publication route, same rule as `suspended`). The
  /// publisher can still see and edit it from their dashboard, unlike a
  /// hard delete.
  rejected
}

/// The advertisement — "this publisher is advertising that Property" (see
/// the schema-header note above `Property` below for the full split). Every
/// physical/canonical attribute (area, bedrooms, condition, amenities,
/// location...) lives on `Property` now; this model keeps only what's
/// actually about THIS publisher's ad of it — price, media, copy,
/// moderation/lifecycle state. Two different agencies advertising the same
/// physical unit would eventually be two Listings pointing at the same
/// Property (dedup isn't implemented yet — every submission still creates
/// its own Property row — but the shape now supports it without another
/// migration).
model Listing {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  transaction    String
  rentSubtype    String?
  price          Float
  currency       String        @default("EUR")
  negotiable     Boolean       @default(false)
  images         String[]
  floorPlanImage String?
  facadeImage    String?
  videoUrl       String?
  descriptionEn  String
  descriptionSq  String
  premium        Boolean       @default(false)
  status         ListingStatus @default(pending)
  createdAt      DateTime      @default(now())
  reviewedAt     DateTime?
  /// Bumped every time the publisher confirms/edits the listing is still
  /// current (a "Renew" action, not every silent admin edit) — the basis
  /// for the "needs an update" staleness flag once it's >90 days old.
  lastRenewedAt  DateTime      @default(now())
  /// Admin can take one specific listing offline for N days without
  /// touching the publisher's whole account — distinct from
  /// `Publisher.restricted*` (that blocks every future listing) and from
  /// `status: "suspended"` (indefinite, requires a second admin action to
  /// reverse).
  idleUntil      DateTime?
  idleReason     String?
  /// Admin "Mark duplicate" action (Listings Control) — a free-text
  /// pointer to another listing's id/slug, not a foreign key: the target
  /// may itself get deleted later, and this is a moderation note, not a
  /// referential relationship the schema needs to enforce. Set together
  /// with `status: "suspended"` by the admin route.
  duplicateOfId  String?

  /// Super Admin recycle bin — see the schema-header note on Listing: no
  /// route has ever written a real row here yet (public catalog is still
  /// mockData.ts), so this column exists for forward-compat, not because
  /// there's anything to soft-delete today.
  deletedAt DateTime?
  deletedBy String?

  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  /// Property/Listing/Transaction split — see the schema-header note above
  /// `Property` below. Required: every Listing advertises exactly one
  /// Property, created alongside it (`POST /api/listings` does both in one
  /// transaction) even though nothing dedupes physical units across
  /// separate submissions yet.
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  /// Admin "Projects" console — optionally ties this listing to one
  /// Project (a development), so admin manages it from inside that
  /// project's own edit view instead of a separate flat Listings tab.
  /// Nullable and `SetNull` on delete: an unlinked/standalone listing (an
  /// individual seller's ad with no development behind it) is a normal,
  /// supported case, and deleting a Project must never cascade-delete the
  /// listings that happened to point at it.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// "Units & Listings, Untangled" — the missing bridge between the
  /// marketplace ad (this row) and the 3D-mapped inventory record a
  /// project's Units tab actually maps onto a GLB mesh. Nullable: most of
  /// this platform's history (and every standalone listing) has none.
  /// When set, `PATCH /api/admin/listings/[id]/publication`'s `status`
  /// write pushes one-way onto the linked Unit (never the reverse) — the
  /// Unit/GLB pipeline has no public submission path of its own to drift
  /// from, so Listing is treated as the side of truth for "did this sell."
  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)

  transactions Transaction[]
  priceHistory PriceHistoryEntry[]

  leads LeadItem[]

  @@map("listings")
}

// ---------------------------------------------------------------------------
// Property/Listing/Transaction split — user's 2026-08-15 spec: "separate the
// physical property from the advertisement." `Property` is the one
// real-world apartment/land/villa/shop — every field describing the
// physical thing itself (specs, condition, amenities, location) now lives
// here, not on `Listing`; `Listing` (above) is one publisher's advertisement
// of it (several agencies can eventually list the same Property, though
// dedup detection isn't implemented yet — every submission still creates
// its own row); each sale/rental/reservation event against it is a
// `Transaction`. See MEMORY note "rozaris-controlled-taxonomy-spec".
// ---------------------------------------------------------------------------

model Property {
  id                String    @id @default(cuid())
  /// Canonical Location System FK — see the schema-header note above
  /// `Location`. Nullable at the schema level (a Property could
  /// theoretically predate a resolvable location) but `POST
  /// /api/listings` always resolves and sets it for real.
  locationId        String?
  location          Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  /// Denormalized alongside `locationId` — same convention `Listing`/
  /// `Project` already use elsewhere in this schema (a raw reference id +
  /// a display string, not just the FK), so read paths that only ever
  /// needed "which neighborhood/city" don't need to join through
  /// `Location` for it.
  neighborhoodId    String?
  city              String?
  lat               Float?
  lng               Float?
  /// True once the publisher has actually dropped a pin on the map
  /// (LocationPicker) — `lat`/`lng` are always populated regardless (a
  /// neighborhood-centroid fallback when this is false), so this is the
  /// real signal, not "are lat/lng non-null". Required to leave `draft`
  /// status unless an admin explicitly approves without one.
  locationConfirmed Boolean   @default(false)
  propertyType      String?
  area              Float?
  landArea          Float?
  buildingPermit    Boolean?
  bedrooms          Int?
  bathrooms         Int?
  floor             Int?
  totalFloors       Int?
  yearBuilt         Int?
  condition         String?
  amenities         String[]
  createdAt         DateTime  @default(now())

  listings Listing[]

  @@map("properties")
}

enum TransactionType {
  sale
  long_term_rent
  short_term_rent
  reservation
}

enum TransactionStatus {
  pending
  completed
  cancelled
}

model Transaction {
  id                String            @id @default(cuid())
  listingId         String
  type              TransactionType
  status            TransactionStatus @default(pending)
  price             Float?
  currency          String            @default("EUR")
  occurredAt        DateTime          @default(now())
  createdAt         DateTime          @default(now())
  /// Market Data Engine's "allow incorrect/outlier transactions to be
  /// excluded from statistics" (PRD_ROZARIS_Admin §12) — a real completed
  /// transaction stays in the table (it's still a fact that happened),
  /// just excluded from the €/m² aggregate `GET /api/admin/market-data`
  /// computes.
  excludedFromStats Boolean           @default(false)
  excludedReason    String?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

/// Spec item 31 ("Price history") — user's 2026-08-15 requirement: "never
/// overwrite a price silently... keep €220,000 — Jan, €210,000 — Mar,
/// €199,000 — Aug... then show 'Price reduced 9.5%'." Distinct from
/// `Transaction`: that's the real sale/rental EVENT (written once, when a
/// listing actually sells); this is every price POINT over the listing's
/// life, including the very first one at creation. See MEMORY note
/// "rozaris-controlled-taxonomy-spec".
model PriceHistoryEntry {
  id         String   @id @default(cuid())
  listingId  String
  price      Float
  currency   String
  recordedAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, recordedAt])
  @@map("price_history_entries")
}

enum ProjectStatus {
  coming_soon
  under_construction
  completed
}

enum ProjectApprovalStatus {
  pending
  active
  archived
}

model Project {
  id              String                @id @default(cuid())
  slug            String                @unique
  name            String
  status          ProjectStatus         @default(coming_soon)
  approvalStatus  ProjectApprovalStatus @default(pending)
  progressPercent Int                   @default(0)
  lat             Float
  lng             Float
  neighborhoodId  String
  city            String
  /// Canonical Location System — same additive/nullable transition as
  /// Listing.locationId above.
  locationId      String?
  location        Location?             @relation(fields: [locationId], references: [id], onDelete: SetNull)
  setting         String
  propertyType    String
  heroImage       String?
  gallery         String[]
  descriptionEn   String
  descriptionSq   String
  buildings       String[]
  amenities       String[]
  premium         Boolean               @default(false)
  completionLabel String?
  createdAt       DateTime              @default(now())
  reviewedAt      DateTime?

  /// Super Admin recycle bin. `approvalStatus` already has `archived` for
  /// the normal "force unpublish" transition (see the admin PATCH route) —
  /// deletedAt is the separate, heavier "remove from every admin view,
  /// restorable from the Recycle Bin" action.
  deletedAt DateTime?
  deletedBy String?

  /// Same "take this one specific listing offline for N days" mechanism
  /// as `Listing.idleUntil` — see that field's doc comment.
  idleUntil  DateTime?
  idleReason String?

  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  units               Unit[]
  constructionStages  ConstructionStage[]
  timelineRequests    ConstructionTimelineRequest[]
  threeDConfig        Project3DConfig?
  mapModel            ProjectMapModel?
  detailModel         ProjectDetailModel?
  mapModelVersions    MapModelVersion[]
  detailModelVersions DetailModelVersion[]
  detailModelSlots    DetailModelSlot[]
  leads               LeadItem[]

  /// Multi-Channel Publishing PRD Phase 2 — see the section comment above
  /// ViewerRelease below for the full picture.
  viewerReleases ViewerRelease[]
  publishTargets ProjectPublishTarget[]
  inventoryState ProjectInventoryState?
  /// Phase 8 — see InventoryConnector's own doc comment.
  inventoryConnectors InventoryConnector[]
  /// Phase 9 — see ProjectMembership's own doc comment.
  memberships         ProjectMembership[]
  /// Admin's "Projects" console — a Listing (marketplace ad) can optionally
  /// belong to one Project (a development), managed from inside that
  /// project's own edit view instead of a separate flat Listings tab.
  /// Nullable: a listing may stand alone with no project (an individual
  /// seller's ad), same as before this relation existed.
  listings            Listing[]

  @@map("projects")
}

model Unit {
  id             String   @id @default(cuid())
  code           String
  type           String
  buildingName   String
  floor          Int
  area           Float
  bedrooms       Int
  bathrooms      Int
  price          Float
  currency       String   @default("EUR")
  transaction    String
  status         String   @default("available")
  images         String[]
  floorPlanImage String?
  facadeImage    String?
  videoUrl       String?

  /// Compass orientation the unit itself faces — a real-estate listing
  /// attribute ("which way do the windows point"), authored per unit in
  /// ProjectUnitsEditor alongside floor/area/price. Deliberately NOT the
  /// same thing as `UnitMeshLinkV2.poiYawDeg`, which also renders as
  /// N/E/S/W but is a per-model-version 3D authoring knob for framing the
  /// POI camera's focus shot: the two are independent (a south-facing
  /// unit can still be best framed from the east) and live on rows with
  /// different lifetimes — poiYawDeg is re-authored per GLB version,
  /// this survives every model re-upload.
  ///
  /// Nullable, and left null on every pre-existing unit: "unknown" is a
  /// legitimate state, and defaulting the live units to North would be
  /// inventing data the editor then shows back as authored.
  orientation    String?

  /// Multi-Channel Publishing PRD Phase 2 — additive-only hardening. The
  /// PRD's own §7 also proposed converting `status` above (bare String) to
  /// a real `UnitAvailability` enum; deliberately NOT done here — 12 files
  /// already do string comparisons/writes against it (unit-status colors,
  /// X-ray overlay, ProjectUnitsEditor, POI camera, mesh-status coloring),
  /// and nothing in Phase 2 actually needs the enum yet. Revisit that
  /// conversion alongside Phase 6/8 (inventory sync / conflict detection),
  /// where `revision` below finally gets a real writer.
  updatedAt DateTime @updatedAt
  /// Optimistic-concurrency counter — inert until Phase 6/8 wires an
  /// `If-Match` check into the inventory-sync write path (PRD §57
  /// "Concurrency"). No writer increments it yet.
  revision  Int      @default(1)

  /// Super Admin recycle bin — the unit PATCH/DELETE route
  /// (api/projects/[projectId]/units/[unitId]) now soft-deletes here
  /// instead of a real prisma.unit.delete().
  deletedAt DateTime?
  deletedBy String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Units Blocks & POI Layer PRD §7 — the real inverse of
  /// UnitMeshLinkV2.unit, added alongside making `unitId` a genuine FK
  /// instead of a bare, unvalidated String.
  unitMeshLinks UnitMeshLinkV2[]

  /// Multi-Channel Publishing PRD Phase 2 — see PublishTargetUnitOverride's
  /// own doc comment for why this is an override list, not a duplicate of
  /// this row.
  publishTargetOverrides PublishTargetUnitOverride[]

  /// "Units & Listings, Untangled" — the marketplace-ad side of this same
  /// physical unit, if a publisher (or admin, from inside this unit's own
  /// project) has posted one. Several listings could in principle point at
  /// one unit (re-listed by a different agency); this unit needs none to
  /// exist. See Listing.unitId's own doc comment for the write direction.
  listings Listing[]

  /// Units Blocks & POI Layer PRD §6 — "Strengthen Unit identity."
  /// Confirmed via a live-DB scan before adding this (zero existing
  /// duplicate (projectId, code) pairs across all 68 active units) —
  /// codes like "A-101"/"B-101" must be unique per project so mesh-name
  /// matching (`normalizeUnitMatchKey`) can never collide across
  /// buildings within the same project.
  @@unique([projectId, code])
  @@map("units")
}

model ConstructionStage {
  id              String @id @default(cuid())
  name            String
  order           Int
  status          String
  progressPercent Int
  dateLabel       String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("construction_stages")
}

// ---------------------------------------------------------------------------
// Per-user domains — the "most important" phase: real, shared, durable state
