// ROZARIS backend schema — see MEMORY note "rozaris-backend-plan" for the
// phased rollout this belongs to. Mirrors src/lib/types.ts (the PRD data
// model) wherever a domain is moving from Zustand/localStorage to a real,
// shared, multi-user store.
//
// Scope note (deliberate, per product decision): the public browse/search
// catalog (Listing/Project *reads*) stays on src/lib/mockData.ts for now —
// that full catalog migration + geo search is a later phase. What lives here
// already is: real auth, the publisher "submit a listing/project" ->
// admin "approve/publish" workflow, and every per-user domain that used to
// be private to one browser's localStorage (saved items, follows,
// notifications, messaging, construction-timeline requests, the two 3D
// admin configs). Newly-submitted Listings/Projects are real rows from day
// one, they just aren't merged into the public search results yet.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Vercel Postgres (Neon) exposes both a pooled and a direct connection —
  // migrations need the direct one to avoid pgbouncer issues.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

enum UserRole {
  buyer
  publisher
  admin
}

enum PublisherType {
  private_owner
  agency
  developer
}

/// Account-level access state, enforced at real sign-in (src/auth.ts's
/// authorize()) — Super Admin control/audit pass. `restricted` is reserved
/// for a future lighter-touch state; only suspended/disabled currently
/// block sign-in.
enum UserStatus {
  active
  restricted
  suspended
  disabled
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  phone         String?   @unique
  passwordHash  String?
  name          String
  role          UserRole  @default(buyer)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  // Super Admin control/audit pass (PRD_ROZARIS_Admin §12 "Account
  // controls", §14 "Change Admin permissions"). adminScopes values mirror
  // the PRD's "Future Admin permission scopes" table — free-text (not an
  // enum) so a new scope can be granted without a migration:
  // listing_reviewer | publisher_verification | 3d_manager |
  // content_manager | finance_admin | support_admin.
  status          UserStatus @default(active)
  statusReason    String?
  statusChangedAt DateTime?
  statusChangedBy String?
  superAdmin      Boolean    @default(false)
  adminScopes     String[]   @default([])
  deletedAt       DateTime?
  deletedBy       String?

  // Auth.js
  accounts Account[]
  sessions Session[]

  // Buyer-side profile fields (PRD_User) — null for publisher/admin accounts.
  buyerPreferences Json?

  // A publisher-role user owns exactly one Publisher org record.
  publisher Publisher?

  savedItems               SavedItem[]
  savedSearches            SavedSearch[]
  follows                  Follow[]
  recentlyViewed           RecentlyViewedEntry[]
  notifications            Notification[]
  sentConversationsAsBuyer Conversation[]        @relation("BuyerConversations")
  messages                 Message[]
  leadStatusOverrides      LeadStatusOverride[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Publishers, Listings, Projects — the "submit -> admin approve -> publish"
// pipeline (public browse still reads mockData.ts; see file header).
// ---------------------------------------------------------------------------

model Publisher {
  id       String        @id @default(cuid())
  slug     String        @unique
  name     String
  type     PublisherType
  verified Boolean       @default(false)
  logoUrl  String?
  phone    String
  whatsapp String?
  bio      String?

  /// "Restrict publishing" (PRD §6 Publisher Admin actions) — prevents new
  /// publication while preserving traceability. Distinct from the owning
  /// User's `status` (that blocks sign-in entirely); this blocks only new
  /// publish actions.
  restricted       Boolean   @default(false)
  restrictedReason String?
  deletedAt        DateTime?
  deletedBy        String?

  ownerUserId String @unique
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  listings Listing[]
  projects Project[]
  leads    LeadItem[]

  createdAt DateTime @default(now())

  @@map("publishers")
}

enum ListingStatus {
  pending // submitted, awaiting admin approval — not yet live anywhere
  active
  sold
  rented
  expired
  suspended
  archived
}

model Listing {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  transaction    String
  rentSubtype    String?
  propertyType   String
  price          Float
  currency       String        @default("EUR")
  negotiable     Boolean       @default(false)
  area           Float
  landArea       Float?
  buildingPermit Boolean?
  bedrooms       Int
  bathrooms      Int
  floor          Int?
  totalFloors    Int?
  yearBuilt      Int?
  condition      String
  amenities      String[]
  lat            Float
  lng            Float
  neighborhoodId String
  city           String
  images         String[]
  floorPlanImage String?
  facadeImage    String?
  videoUrl       String?
  descriptionEn  String
  descriptionSq  String
  premium        Boolean       @default(false)
  status         ListingStatus @default(pending)
  createdAt      DateTime      @default(now())
  reviewedAt     DateTime?

  /// Super Admin recycle bin — see the schema-header note on Listing: no
  /// route has ever written a real row here yet (public catalog is still
  /// mockData.ts), so this column exists for forward-compat, not because
  /// there's anything to soft-delete today.
  deletedAt DateTime?
  deletedBy String?

  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  leads LeadItem[]

  @@map("listings")
}

enum ProjectStatus {
  coming_soon
  under_construction
  completed
}

enum ProjectApprovalStatus {
  pending
  active
  archived
}

model Project {
  id              String                @id @default(cuid())
  slug            String                @unique
  name            String
  status          ProjectStatus         @default(coming_soon)
  approvalStatus  ProjectApprovalStatus @default(pending)
  progressPercent Int                   @default(0)
  lat             Float
  lng             Float
  neighborhoodId  String
  city            String
  setting         String
  propertyType    String
  heroImage       String?
  gallery         String[]
  descriptionEn   String
  descriptionSq   String
  buildings       String[]
  amenities       String[]
  premium         Boolean               @default(false)
  completionLabel String?
  createdAt       DateTime              @default(now())
  reviewedAt      DateTime?

  /// Super Admin recycle bin. `approvalStatus` already has `archived` for
  /// the normal "force unpublish" transition (see the admin PATCH route) —
  /// deletedAt is the separate, heavier "remove from every admin view,
  /// restorable from the Recycle Bin" action.
  deletedAt DateTime?
  deletedBy String?

  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  units               Unit[]
  constructionStages  ConstructionStage[]
  timelineRequests    ConstructionTimelineRequest[]
  threeDConfig        Project3DConfig?
  mapModel            ProjectMapModel?
  detailModel         ProjectDetailModel?
  mapModelVersions    MapModelVersion[]
  detailModelVersions DetailModelVersion[]
  detailModelSlots    DetailModelSlot[]
  leads               LeadItem[]

  @@map("projects")
}

model Unit {
  id             String   @id @default(cuid())
  code           String
  type           String
  buildingName   String
  floor          Int
  area           Float
  bedrooms       Int
  bathrooms      Int
  price          Float
  currency       String   @default("EUR")
  transaction    String
  status         String   @default("available")
  images         String[]
  floorPlanImage String?
  facadeImage    String?
  videoUrl       String?

  /// Super Admin recycle bin — the unit PATCH/DELETE route
  /// (api/projects/[projectId]/units/[unitId]) now soft-deletes here
  /// instead of a real prisma.unit.delete().
  deletedAt DateTime?
  deletedBy String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("units")
}

model ConstructionStage {
  id              String @id @default(cuid())
  name            String
  order           Int
  status          String
  progressPercent Int
  dateLabel       String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("construction_stages")
}

// ---------------------------------------------------------------------------
// Per-user domains — the "most important" phase: real, shared, durable state
// that today lives only in one browser's localStorage.
// ---------------------------------------------------------------------------

enum SavedEntityType {
  listing
  project
  neighborhood
}

model SavedItem {
  id         String          @id @default(cuid())
  userId     String
  entityType SavedEntityType
  entityId   String
  createdAt  DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@map("saved_items")
}

model SavedSearch {
  id             String   @id @default(cuid())
  userId         String
  name           String
  filtersSummary String
  filters        Json
  cadence        String   @default("off")
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saved_searches")
}

enum FollowKind {
  project
  developer
}

model Follow {
  id        String     @id @default(cuid())
  userId    String
  kind      FollowKind
  targetId  String
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, targetId])
  @@map("follows")
}

model RecentlyViewedEntry {
  id       String   @id @default(cuid())
  userId   String
  kind     String
  entityId String
  viewedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, entityId])
  @@map("recently_viewed")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  titleKey  String
  bodyKey   String
  vars      Json?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Buyer <-> Publisher messaging
// ---------------------------------------------------------------------------

model Conversation {
  id           String   @id @default(cuid())
  buyerId      String
  publisherId  String
  listingTitle String?
  listingSlug  String?
  createdAt    DateTime @default(now())

  buyer    User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("conversations")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  senderRole     String
  text           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

// ---------------------------------------------------------------------------
// Admin-approved construction timeline edits
// ---------------------------------------------------------------------------

enum TimelineRequestStatus {
  pending
  approved
  rejected
}

model ConstructionTimelineRequest {
  id              String                @id @default(cuid())
  projectId       String
  publisherId     String
  progressPercent Int
  stages          Json
  status          TimelineRequestStatus @default(pending)
  submittedAt     DateTime              @default(now())
  reviewedAt      DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("construction_timeline_requests")
}

// ---------------------------------------------------------------------------
// Admin's two 3D authoring surfaces — one row per project each, replacing
// the store's project3DConfigs / projectMapModels Records.
//
// ProjectMapModel/ProjectDetailModel/UnitMeshLink below are LEGACY as of
// the versioning pass (PRD_Admin_Mapbox_GLB / PRD_Admin_3D_Project_Experience)
// — superseded by MapModelVersion/DetailModelVersion/UnitMeshLinkV2 further
// down, which add version history, draft/publish/rollback and validation
// status instead of one mutable row per project. Kept in place, unused by
// any route once the admin editors switch over, as a one-release safety
// net (their data was copied forward by scripts/migrate-3d-versions.ts) —
// drop them in a follow-up migration once the new tables are confirmed
// stable in production. Project3DConfig is now real as of the "3D
// Experience Phase 1" pass (GET/PATCH /api/project-3d-config/[projectId],
// see src/lib/adminAuth.ts's requireAdmin() for the write gate) — the
// rendering-mode/quality-preset/glass/sky/sun fields below drive the
// standalone WebGPU/WebGL2 viewer (ProceduralProjectViewer.tsx), which
// replaced the old Mapbox-embedded detail-model path in the same pass.
// ---------------------------------------------------------------------------

model Project3DConfig {
  projectId                     String  @id
  groundEnabled                 Boolean @default(true)
  /// "disc" | "infinite" — Ground Platform follow-up (same day as Sky/
  /// Water/Bloom/Clouds). "infinite" is the only style available in GLB
  /// mode; "disc" stays procedural-mode-only, unchanged — deliberately
  /// scoped so no existing GLB project gains an unrequested ground.
  groundStyle       String  @default("disc")
  /// Applies regardless of groundStyle — default matches the exact hex
  /// the ground was hardcoded to before this column existed.
  groundColor       String  @default("#d8d6e6")
  /// Real "ground fog" — a circular radial color fade on the ground
  /// mesh's own material around world origin (0,0,0), distinct from
  /// fogEnabled/fogColor's camera-relative THREE.FogExp2 above. Off by
  /// default.
  groundFogEnabled  Boolean @default(false)
  /// World-space distance from (0,0,0) — admin-entered directly.
  groundFogRadius   Float   @default(300)
  cameraStartDistanceMultiplier Float   @default(1)
  cameraMinDistanceMultiplier   Float   @default(0.4)
  cameraMaxDistanceMultiplier   Float   @default(2.5)
  cameraMaxPolarDeg             Int     @default(85)
  cameraMinPolarDeg             Int     @default(0)
  autoRotate                    Boolean @default(true)
  // "Construction Stage reveal" (the translucent per-building shell
  // outlines + progressive per-floor unit-box hiding based on
  // constructionProgressPercent, both procedural-mode-only — see
  // RenderEngine.ts's git history) removed entirely 2026-08-14 at the
  // user's explicit request, along with its `constructionStagesEnabled`
  // column — not kept as a dead toggle. The separate, still-live
  // `constructionProgressPercent` shown in the public viewer's header
  // pill/timeline strip (useProjectConstruction/ConstructionTimelineStrip)
  // is untouched — it never depended on this column.
  status                        String  @default("draft")

  // "3D Experience Phase 1" — rendering foundation, quality presets, glass.
  // See src/lib/viewerPresets.ts.
  renderingMode        String  @default("auto") // auto | webgpu | webgl2
  qualityPreset        String  @default("high_desktop")
  // ultra_desktop | high_desktop | balanced | mobile_high | mobile_low
  glassPreset          String  @default("standard") // performance | standard | premium
  environmentIntensity Float   @default(1)
  cameraFovDesktop     Int     @default(38)
  cameraFovMobile      Int     @default(48)

  /// Sky/Water/Bloom/Clouds "Ocean" tab (webgl_shaders_ocean.html parity)
  /// — direct sun elevation/azimuth feeding the physical SkyMesh, matching
  /// the reference demo's own GUI exactly (no geographic date/time
  /// simulation, no manual/geographic mode split — this is the only sun
  /// model now). Removed 2026-08-14 at the user's explicit request,
  /// along with the whole geographic-sun/HDRI/lensflare/light-probe/
  /// motion-blur system this project had grown around it: sunMode,
  /// sunIntensity, northRotationDeg, defaultTimeOfDay, allowUserTimeChange,
  /// simulationDate, hdriId (+ the PlatformHdri table), lensflareEnabled,
  /// lightProbeEnabled, motionBlurEnabled/Amount, skyPreset,
  /// backgroundPreset, backgroundBlurriness, bloomThreshold, and the
  /// separate volumetricCloud* fields (a different reference demo,
  /// webgl_volume_cloud.html — out of scope for this tab). Not kept as
  /// dead toggles — dropped as real columns via a live migration.
  /// `lightingPreset` (already dead/unread) dropped in the same pass.
  /// `lutEnabled`/`lutPreset`/`lutIntensity` (3D LUT color grading) is
  /// explicitly KEPT, further down this model — see its own doc comment.
  sunAzimuthDeg   Float @default(180)
  sunElevationDeg Float @default(45)

  /// New standalone "Sky" tab (webgl_shaders_sky.html parity, 2026-08-14
  /// — separate from and added after the "Ocean" tab above). That
  /// reference demo's own GUI is elevation/azimuth/exposure (already
  /// covered by sunElevationDeg/sunAzimuthDeg/exposure — reused, not
  /// duplicated as columns) plus turbidity/rayleigh/mieCoefficient/
  /// mieDirectionalG, previously a single fixed constant
  /// (viewerPresets.ts's SKY_PHYSICAL_PARAMS) applied to every project —
  /// now real per-project columns, defaulted to that exact prior fixed
  /// tuple so no existing project's rendered sky changes until an admin
  /// touches this tab. `skyEnabled` is a Rozaris-specific addition (the
  /// reference demo has no off switch — its Sky is always the scene) per
  /// explicit user request ("possibility to turn off"); false falls back
  /// to a flat neutral background/environment instead of the physical
  /// dome — see RenderEngine.ts's rebuildEnvironment. Default true: zero
  /// behavior change for any existing project (the physical sky dome was
  /// already the unconditional backdrop before this column existed).
  skyEnabled          Boolean @default(true)
  skyTurbidity        Float   @default(4)
  skyRayleigh         Float   @default(2.4)
  skyMieCoefficient   Float   @default(0.004)
  skyMieDirectionalG  Float   @default(0.78)

  // Full-configurator pass — Fog, per-project unit status colors, and
  // per-project post-processing overrides (ANDed with, not replacing,
  // QUALITY_TIERS' own tier-level flags — see viewerPresets.ts).
  fogEnabled Boolean @default(false)
  fogColor   String  @default("#c9d6e0")
  fogDensity Float   @default(0.015)
  /// When true, fog color is derived live from the resolved sky color
  /// instead of the authored `fogColor` above — the "seamless horizon"
  /// technique from three.js's webgl_geometry_terrain example. Default
  /// false: zero behavior change for any existing project.
  fogMatchesSky Boolean @default(false)
  // `sectionCapStencilEnabled` column removed 2026-08-14 — the real
  // stencil-buffer-derived Section cap silhouette (webgl_clipping_stencil.html
  // technique) it gated is no longer a project-wide opt-in: it's now
  // unconditional for any `fillGapsEnabled` section (RenderEngine.ts's
  // rebuildSectionCap), since the opt-in default (off) is exactly what
  // was reported as "colors the clipper plane instead [of the clipped
  // model]" — the toggle was buried in the Effects tab, off by default,
  // invisible from the Sections tab where fillColor is actually picked,
  // so almost nobody ever found their way to the already-correct
  // behavior. `stencil: true` moved to the WebGPURenderer's fixed
  // constructor options instead of this column.

  // Sky/Water/Bloom/Clouds pass (webgl_shaders_ocean.html parity) —
  // real HDR bloom (dormant TSL node, now a per-project toggle), a real
  // WaterMesh water plane, and procedural clouds on the physical sky
  // dome (SkyMesh — see RenderEngine.ts's rebuildEnvironment, which
  // replaced the old CanvasTexture gradient sky with it this same pass).
  // All default false/off: zero behavior change for any existing project
  // beyond the sky itself becoming physically-based (an accepted visual
  // change, not gated behind a flag — see the plan's Sky Rollout
  // decision).
  bloomEnabled  Boolean @default(false)
  bloomStrength Float   @default(0.1)
  bloomRadius   Float   @default(0)

  waterEnabled         Boolean @default(false)
  waterDistortionScale Float   @default(3.7)
  waterSize            Float   @default(1)

  /// Sky/Water/Bloom/Clouds "Ocean" tab — webgl_shaders_ocean.html's own
  /// "Clouds" GUI folder is really 3 more uniforms on its Sky object, not
  /// a separate mesh; these feed SkyMesh.cloudCoverage/cloudDensity/
  /// cloudElevation directly (see RenderEngine.ts's applySunAndEnvironment).
  /// A different, second cloud implementation (real 3D-texture
  /// raymarching, webgl_volume_cloud.html parity) used to live alongside
  /// this one on its own tab — removed entirely 2026-08-14 (out of scope
  /// for this demo's own Clouds panel), along with its
  /// volumetricCloudEnabled/Threshold/Opacity/Range/Steps columns.
  cloudsEnabled  Boolean @default(false)
  cloudCoverage  Float   @default(0.4)
  cloudDensity   Float   @default(0.5)
  cloudElevation Float   @default(0.5)

  /// webgl_watch.html parity — real, previously-unset THREE.js property
  /// (DirectionalLight.shadow.radius) that always defaulted to its engine
  /// default (0 — hard shadow edge) with no admin control. Default here
  /// matches that engine default exactly.
  shadowSoftness Float @default(0)

  // 3D LUT color grading (webgl_postprocessing_3dlut.html parity) — every
  // option the reference demo's own GUI exposes: `enabled`, a 9-way `lut`
  // dropdown (all 9 of the demo's own vendored presets — 5 real `.CUBE`
  // files via `LUTCubeLoader`, 1 real `.3dl` file via `LUT3dlLoader`, 3
  // real image-strip LUTs via `LUTImageLoader` — see viewerPresets.ts's
  // `LUT_PRESETS` and RenderEngine.ts's `loadLut` for the loader-per-
  // format dispatch, and `public/luts/` for the vendored assets), and
  // `intensity`. `lutPreset` is a free string, not a Prisma enum,
  // validated against the real available-preset list at the zod layer
  // instead. Off by default: zero behavior change for any existing
  // project.
  lutEnabled   Boolean @default(false)
  lutPreset    String  @default("bourbon64")
  lutIntensity Float   @default(1)

  // Depth of field (webgl_postprocessing_dof2.html parity) — TSL `dof()`
  // node, real bokeh blur sampled from the scene's own viewZ (depth)
  // buffer. `focusDistance` isn't a stored field — RenderEngine.ts
  // recomputes it every frame from the real live camera-to-orbit-target
  // distance (`camera.position.distanceTo(controls.target)`), same "auto-
  // focus on whatever's framed" behavior a real camera's autofocus gives,
  // rather than a manual distance an admin would have to keep in sync with
  // wherever a visitor happens to orbit the camera. `focalLength`/
  // `bokehScale` mirror the TSL node's own param names/defaults (1/1).
  // Off by default: zero behavior change for any existing project.
  depthOfFieldEnabled     Boolean @default(false)
  depthOfFieldFocalLength Float   @default(10)
  depthOfFieldBokehScale  Float   @default(1)

  /// Real logarithmic depth buffer (`webgpu_camera_logarithmicdepthbuffer.html`
  /// parity) — `logarithmicDepthBuffer: true` passed to the WebGPURenderer
  /// constructor, reducing z-fighting at this app's scale (camera far
  /// plane is a fixed 2000 units — see RenderEngine.ts's mount()). A
  /// renderer-construction-time flag like `stencil`/`forceWebGL`, so it
  /// needs a fresh mount to take effect. Default false: zero behavior
  /// change for any existing project.
  logarithmicDepthEnabled Boolean @default(false)

  /// Loading-screen reveal (webgl_postprocessing_transition.html
  /// technique) — real per-project on/off (per explicit user request:
  /// "every feature has an option to turn it on/off"). Default true is a
  /// deliberate exception to this file's usual "off by default" rule —
  /// same "accepted visual default change, not gated behind a flag"
  /// precedent the physical sky dome rollout already used — since this is
  /// a purely cosmetic one-time mount transition with no functional
  /// behavior to preserve for existing projects.
  loadingRevealEnabled Boolean @default(true)

  /// Hex colors for the 4 unit statuses + the shared "selected" highlight —
  /// defaults match the previously-hardcoded UNIT_BOX_COLOR/SELECTED_COLOR
  /// constants in viewerPresets.ts exactly, so existing projects render
  /// identically until an admin changes them.
  unitColorAvailable String @default("#22c55e")
  unitColorReserved  String @default("#eab308")
  unitColorSold      String @default("#ef4444")
  unitColorSelected  String @default("#6b55f5")

  // Unit-status caustics (webgpu_caustics.html parity, adapted — see
  // RenderEngine.ts's buildCausticsNode doc comment for the real technique
  // and the honest deviations from the reference's refract()/
  // castShadowNode approach) — procedural-mode unit boxes only. Explicitly
  // linked to all 3 things the user asked for: color reuses the real
  // unitColor* fields above (no separate caustics-color fields), intensity
  // is per-availability-status (causticsIntensity*), and scale/speed are
  // the real tunable caustics properties. Off by default: zero behavior
  // change for any existing project.
  causticsEnabled           Boolean @default(false)
  causticsScale             Float   @default(0.5)
  causticsSpeed             Float   @default(0.15)
  causticsIntensityAvailable Float  @default(1)
  causticsIntensityReserved  Float  @default(0.4)
  causticsIntensitySold      Float  @default(0)

  /// shadowsEnabled/antialiasEnabled are real and functional. ssrEnabled/
  /// gtaoEnabled (screen-space reflections/ambient occlusion) used to be
  /// columns here — dropped entirely 2026-08-13 at the user's explicit
  /// request, after that TSL chain caused two unexplained real-GPU
  /// rendering failures and was implicated in a later real Sections-panel
  /// instability report. See viewerPresets.ts's QUALITY_TIERS header
  /// comment for the full history.
  shadowsEnabled   Boolean @default(true)
  antialiasEnabled Boolean @default(true)

  // Render/visual quality pass — real TSL post-processing, camera
  // presets. See src/lib/viewerPresets.ts (quality-tier post-fx flags)
  // and ProceduralProjectViewer.tsx (RenderPipeline wiring).
  /// Admin-saved camera framings — [{ id, label, position: {x,y,z},
  /// target: {x,y,z}, fov, durationMs, easing }]. Clicking one in the
  /// public viewer smoothly transitions the live camera to it.
  cameraPresets Json?
  /// Tone-mapping exposure multiplier (renderer.toneMappingExposure) —
  /// also the Sky/Water/Bloom/Clouds "Ocean" tab's Sky "exposure" slider,
  /// matching webgl_shaders_ocean.html's own GUI exactly. renderer.
  /// toneMapping itself is fixed to ACESFilmic (not made per-project
  /// configurable).
  exposure      Float @default(1)

  // Publish/runtime hardening pass.
  /// Which of the always-on bottom-menu controls (Home/Unit Search/Time
  /// of Day/View Preset) show publicly — { home, unitSearch, timeOfDay,
  /// viewPreset }, all booleans. Xray/Camera Presets aren't included:
  /// they're already conditional on real state (a loaded GLB / at least
  /// one saved preset). Null/absent reads as "all enabled" client-side —
  /// no backfill migration needed for existing rows.
  viewerUI Json?

  // Sections module (first-class Configurator module) — admin-authored
  // rectangular clipping-plane cuts. [{ id, name, scope, buildingName?,
  // centerX, centerZ, widthM, depthM, rotationDeg, heightM, bottomEnabled,
  // stylePreset, cameraPreset?, floorId?, hidden? }], see the `Section`
  // TS interface (src/lib/types.ts) for the full shape. Never touches the
  // GLB itself — render-time clipping planes/cap only. Null/absent reads
  // as `[]` client-side, same nullable-Json?-column pattern as
  // cameraPresets/viewerUI above — no backfill needed for existing rows.
  sections Json?

  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_3d_configs")
}

// `PlatformHdri` (a shared, platform-wide HDRI environment map — Task 2,
// Track A) removed entirely 2026-08-14 along with `Project3DConfig.hdriId`
// — the Sky/Water/Bloom/Clouds "Ocean" tab replaces the old HDRI/
// procedural-sky-preset background system with the physical SkyMesh as the
// only backdrop, so there's no longer a background mode for a Platform
// HDRI to apply to.

/// Admin's "3D Map Control" GLB placement — glbUrl now points at a real
/// Vercel Blob object (shared, public, permanent) instead of one browser's
/// IndexedDB, which is exactly the gap flagged when this feature shipped:
/// "nobody else sees Admin's own-browser upload".
model ProjectMapModel {
  projectId         String   @id
  glbUrl            String
  fileName          String
  fileSize          Int
  scale             Float    @default(1)
  rotationDeg       Float    @default(0)
  altitudeOffset    Float    @default(0)
  enabled           Boolean  @default(false)
  /// Hides the basemap's real 3D building footprint at this project's
  /// coordinates (see src/components/map/BuildingHider.ts) so the GLB
  /// replaces it cleanly instead of sitting alongside/inside it.
  hideBaseBuilding  Boolean  @default(false)
  /// Manually picked anchor point ("Pick Building to Remove" in
  /// MapModelEditor) used to resolve which real building footprint to hide,
  /// instead of always assuming it's the one nearest the project's own
  /// coordinates — the project pin doesn't always sit exactly on the
  /// footprint. Null falls back to the project's coordinates (legacy /
  /// not yet manually picked).
  hiddenBuildingLng Float?
  hiddenBuildingLat Float?
  updatedAt         DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_map_models")
}

/// Admin's "Project 3D Experience" detailed GLB — a second, separate upload
/// from ProjectMapModel above. That one is deliberately minimalistic (search
/// page performance, many projects rendered at once); this one is the real,
/// highly-detailed architectural model for a single project's own viewer
/// page (/project/[slug]), authored with individual `Unit_<number>` box
/// nodes baked in so Admin can link each one to a real Unit and have it
/// render as a colored, clickable availability box. Same real-Postgres-row
/// reasoning as ProjectMapModel: the URL and links must be shared/durable,
/// not one browser's local state.
model ProjectDetailModel {
  projectId      String   @id
  glbUrl         String
  fileName       String
  fileSize       Int
  scale          Float    @default(1)
  rotationDeg    Float    @default(0)
  altitudeOffset Float    @default(0)
  enabled        Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unitLinks UnitMeshLink[]

  @@map("project_detail_models")
}

/// One row per admin-confirmed link between a named `Unit_<number>` node
/// found inside a ProjectDetailModel's GLB and a real Unit. Node names are
/// whatever the 3D artist authored them as in the source file — not
/// guaranteed to match Unit.code — so this mapping is explicit, not inferred.
model UnitMeshLink {
  id        String   @id @default(cuid())
  projectId String
  meshName  String
  unitId    String
  updatedAt DateTime @updatedAt

  detailModel ProjectDetailModel @relation(fields: [projectId], references: [projectId], onDelete: Cascade)

  @@unique([projectId, meshName])
  @@map("unit_mesh_links")
}

// ---------------------------------------------------------------------------
// Versioned 3D asset pipeline (PRD_Admin_Mapbox_GLB, PRD_Admin_3D_Project_Experience)
// — Upload -> Validate -> Configure -> Preview -> Publish, with version
// history, draft/publish/rollback and an audit trail. Supersedes
// ProjectMapModel/ProjectDetailModel/UnitMeshLink above (see their comment).
// ---------------------------------------------------------------------------

enum ModelValidationStatus {
  ready
  warning
  blocked
}

enum ModelPublicationStatus {
  draft
  published
  archived
}

/// One immutable version of a project's lightweight search-map GLB
/// placement. Only one row per project may have publicationStatus
/// "published" at a time (enforced in the publish/rollback route handlers,
/// not a DB constraint — Postgres partial-unique indexes aren't modeled by
/// Prisma's schema syntax without raw SQL).
model MapModelVersion {
  id                String                 @id @default(cuid())
  projectId         String
  version           Int
  sourceAssetUrl    String
  publicAssetUrl    String
  fileName          String
  fileSize          Int
  triangleCount     Int?
  meshCount         Int?
  materialCount     Int?
  textureCount      Int?
  latitude          Float
  longitude         Float
  altitude          Float                  @default(0)
  heading           Float                  @default(0)
  scale             Float                  @default(1)
  minZoom           Int                    @default(13)
  fullDetailZoom    Int                    @default(16)
  maxZoom           Int?
  hideBaseBuilding  Boolean                @default(false)
  /// LEGACY as of the multi-building-pick pass — superseded by
  /// `hiddenBuildings` below (one point could never express "delete these
  /// 3 specific buildings"). Kept, unused, one-release safety net — same
  /// pattern as ProjectMapModel elsewhere in this schema.
  hiddenBuildingLng Float?
  hiddenBuildingLat Float?
  /// Array of `{ lng, lat, footprint: GeoJSON.Polygon | MultiPolygon | null,
  /// featureId?: string | number }` — each entry is one real building Admin
  /// picked to remove, with its footprint geometry captured once at pick
  /// time (not re-queried later, so it survives the public map being at a
  /// different zoom where the footprint might not be queryable). See
  /// src/components/map/BuildingHider.ts.
  hiddenBuildings   Json?
  validationStatus  ModelValidationStatus  @default(ready)
  validationIssues  Json?
  publicationStatus ModelPublicationStatus @default(draft)
  uploadedBy        String?
  publishedBy       String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  publishedAt       DateTime?

  /// Super Admin recycle bin — the version DELETE route now soft-deletes
  /// (Blob file kept) instead of a real prisma.delete(); a Super Admin
  /// hard-delete is what actually removes the Blob object.
  deletedAt DateTime?
  deletedBy String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@index([projectId, publicationStatus])
  @@map("map_model_versions")
}

/// A named "slot" a project's detailed 3D Experience can hang independent
/// GLBs off of — e.g. "Building" and "Surroundings" — so replacing one
/// doesn't touch the other. Admin-created (name is free text), always at
/// least one per project once any detail GLB exists (the migrate-detail-
/// model-slots.ts backfill creates a "Building" slot for every project
/// that already had DetailModelVersion rows before this table existed).
model DetailModelSlot {
  id        String   @id @default(cuid())
  projectId String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  project  Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions DetailModelVersion[]

  @@index([projectId])
  @@map("detail_model_slots")
}

/// One immutable version of a project's detailed Three.js-experience GLB —
/// same versioning shape as MapModelVersion above, plus its own unit mesh
/// mapping (UnitMeshLinkV2) since mappings are meaningful per-version, not
/// per-project (a replacement GLB can rename/remove mesh nodes). Scoped to
/// one DetailModelSlot — `projectId` is kept alongside `slotId` too
/// (denormalized, same tolerance this schema already has elsewhere) so
/// existing `where: { projectId }` queries don't all need an extra join.
model DetailModelVersion {
  id                 String                 @id @default(cuid())
  projectId          String
  slotId             String
  version            Int
  sourceAssetUrl     String
  publicAssetUrl     String
  fileName           String
  fileSize           Int
  triangleCount      Int?
  meshCount          Int?
  materialCount      Int?
  textureCount       Int?
  scale              Float                  @default(1)
  rotationDeg        Float                  @default(0)
  altitudeOffset     Float                  @default(0)
  validationStatus   ModelValidationStatus  @default(ready)
  validationIssues   Json?
  /// Full node list for this version's GLB (not just Unit_* — see
  /// UnitMeshLinkV2 for that), computed server-side at upload time by
  /// glbValidate.ts. One entry per glTF node: { rzNodeId, name, meshIndex,
  /// parentRzNodeId, depth, isMesh, autoClassification }. Regenerated
  /// fresh on every new version, same lifecycle as validationIssues.
  sceneManifest      Json?
  /// Admin-authored classification/material overrides, keyed by rzNodeId:
  /// { rzNodeId, classification?, materialPreset?, colorHex?, roughness?,
  /// metalness?, visible?, carried? }[]. Carried forward by node NAME on a
  /// new version upload (same idea as UnitMeshLinkV2's carried/
  /// needs_review, hand-rolled here since this is a JSON blob, not a
  /// relational table with its own mappingStatus column).
  nodeOverrides      Json?
  /// The full ExperienceDocument snapshot for this revision (rewrite Track
  /// B, Phase 1 — src/lib/experienceDocument.ts's buildExperienceDocument()
  /// is the only writer). Additive: assembled FROM the fields above plus
  /// the project's Project3DConfig row at write time, not a replacement
  /// for them yet — every existing route/hook keeps reading those directly.
  /// Null for any version created before this column existed.
  experienceDocument Json?
  publicationStatus  ModelPublicationStatus @default(draft)
  uploadedBy         String?
  publishedBy        String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  publishedAt        DateTime?

  /// Super Admin recycle bin — same soft-delete-then-Blob-on-hard-delete
  /// pattern as MapModelVersion.
  deletedAt DateTime?
  deletedBy String?

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slot      DetailModelSlot  @relation(fields: [slotId], references: [id], onDelete: Cascade)
  unitLinks UnitMeshLinkV2[]

  @@unique([slotId, version])
  @@index([projectId, publicationStatus])
  @@index([slotId, publicationStatus])
  @@map("detail_model_versions")
}

/// Admin-confirmed link between a GLB mesh/node name and a real Unit,
/// scoped to one DetailModelVersion — PRD_Admin_3D_Project_Experience §19
/// "Mapping Version Behavior": a replacement version's route handler
/// copies forward links whose mesh name still exists in the new GLB
/// (mappingStatus "carried"), everything else starts "needs_review".
model UnitMeshLinkV2 {
  id                   String   @id @default(cuid())
  detailModelVersionId String
  meshName             String
  unitId               String
  /// mapped (admin-confirmed on this version) | carried (auto-copied from
  /// the prior published version, same mesh name) | needs_review (new/
  /// renamed mesh, or the carry-forward source was itself unconfirmed).
  mappingStatus        String   @default("mapped")
  mappedAt             DateTime @default(now())

  detailModelVersion DetailModelVersion @relation(fields: [detailModelVersionId], references: [id], onDelete: Cascade)

  @@unique([detailModelVersionId, meshName])
  @@map("unit_mesh_links_v2")
}

/// Real audit trail for the versioned 3D pipeline's admin actions (upload,
/// publish, rollback, discard). Separate from the Dashboard-Architecture
/// pass's session-local Zustand `auditLog` slice, which has no real backend
/// actions to log against yet — an acknowledged, flagged inconsistency
/// rather than a forced unification of two different kinds of "admin
/// action" (one real/DB-backed, one still client-side mock).
model AuditLog {
  id          String   @id @default(cuid())
  actor       String
  action      String
  entityType  String
  entityId    String
  entityLabel String?
  createdAt   DateTime @default(now())

  // Super Admin control/audit pass — all additive/optional so every one of
  // the ~15 pre-existing logAuditEvent() call sites keeps compiling
  // untouched. This table now doubles as the version-history source: any
  // row carrying previousState/newState IS a restorable version, read back
  // by /api/admin/entities/[type]/[id]/restore-version instead of a
  // separate per-entity revision table.
  actorId       String?
  actorRole     String?
  reason        String?
  previousState Json?
  newState      Json?
  metadata      Json?
  ip            String?
  /// Set only on the final row written by a Super Admin hard-delete — the
  /// underlying record is gone, but this entry (with its previousState
  /// snapshot) is kept forever as the last trace of it.
  hardDeleted   Boolean @default(false)

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("admin_audit_log")
}

/// Forward-only log of real failures from the new admin write routes'
/// catch blocks (System Health panel). No retroactive backfill — errors
/// from before this table existed aren't recoverable.
model ApiErrorLog {
  id        String   @id @default(cuid())
  route     String
  message   String
  stack     String?
  actor     String?
  createdAt DateTime @default(now())

  @@index([route])
  @@map("admin_api_error_log")
}

// ---------------------------------------------------------------------------
// Publisher leads
// ---------------------------------------------------------------------------

enum LeadStatus {
  new
  contacted
  viewing
  negotiating
  closed
  archived
}

model LeadItem {
  id          String     @id @default(cuid())
  publisherId String
  listingId   String?
  projectId   String?
  source      String
  status      LeadStatus @default(new)
  createdAt   DateTime   @default(now())

  publisher Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  listing   Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@map("leads")
}

model LeadStatusOverride {
  id     String     @id @default(cuid())
  userId String
  leadId String     @unique
  status LeadStatus

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lead_status_overrides")
}

// ---------------------------------------------------------------------------
// Platform settings — singleton row (id always "singleton").
// ---------------------------------------------------------------------------

model PlatformSettings {
  id           String   @id @default("singleton")
  eurToAllRate Float    @default(97)
  updatedAt    DateTime @updatedAt

  @@map("platform_settings")
}
