# Public Mapbox access token (pk.xxxx) — required for the live 3D map.
# Get one at https://account.mapbox.com/access-tokens/
# Without it, the app gracefully falls back to a list-only experience (PER-009).
NEXT_PUBLIC_MAPBOX_TOKEN=

# Vercel Postgres (Neon) — Vercel project dashboard -> Storage -> Create
# Database -> Postgres. Copy both the pooled and the direct ("unpooled")
# connection strings it gives you; migrations need the direct one.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel Blob — Vercel project dashboard -> Storage -> Create -> Blob.
# Used for Admin's "3D Map Control" GLB uploads and listing/project images.
BLOB_READ_WRITE_TOKEN=

# Auth.js — any long random string (e.g. `openssl rand -base64 32`).
AUTH_SECRET=
